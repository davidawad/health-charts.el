{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "a1c-trend",
    "version": "1.0.0",
    "doc": "HbA1c (%) over time against category bands bound from the data source (each band carries its own status: low, near, ok or high); bands are filled and readings colored and shaped by that status, with an optional personal target line.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, value}: an ISO date and the HbA1c percent, oldest first"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "HbA1c (%) over time against category bands bound from the data source (each band carries its own status: low, near, ok or high); bands are filled and readings colored and shaped by that status, with an optional personal target line.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "bands": {
        "type": "array",
        "required": true,
        "doc": "required, from the data source: category bands [{label, low, high, status, color?}], drawn bottom to top; status is low, near, ok or high and decides the band's color and each reading's status; color optionally overrides the band's fill"
      },
      "target": {
        "type": "number",
        "default": null,
        "doc": "optional personal target: a dashed line in the ink color"
      },
      "y_title": {
        "type": "string",
        "default": "HbA1c (%)",
        "doc": "y-axis title"
      },
      "x_format": {
        "type": "string",
        "default": "%b %d",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no band holds the value (the theme's grey)"
      }
    },
    "example": "examples/a1c-trend.data.json",
    "health": {
      "group": "metabolic",
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "value": "number"
          },
          "order": "time"
        },
        "bands": {
          "fields": {
            "label": "string",
            "low": "number",
            "high": "number",
            "status": "enum:low|near|ok|high",
            "color": "?string"
          },
          "rows": [
            {
              "le": [
                "low",
                "high"
              ],
              "code": "range_inverted"
            }
          ],
          "min_rows": 1
        }
      },
      "text_size": [
        100,
        26
      ],
      "svg_size": [
        1000,
        420
      ]
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 260,
  "data": {
    "name": "data"
  },
  "layer": [
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "band-bad",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          },
          {
            "filter": {
              "x-eas:expr": "{{@status}} == 'low' || {{@status}} == 'high'"
            }
          }
        ],
        "mark": {
          "type": "rect",
          "clip": true,
          "opacity": 0.22,
          "color": {
            "x-eas:item": "color",
            "default": {
              "x-eas:slot": "bad_color"
            }
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "y2": {
            "datum": {
              "x-eas:item": "high"
            }
          },
          "tooltip": [
            {
              "value": {
                "x-eas:text": "{{@label}}"
              },
              "title": "band"
            }
          ]
        }
      }
    },
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "band-near",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          },
          {
            "filter": {
              "x-eas:expr": "{{@status}} == 'near'"
            }
          }
        ],
        "mark": {
          "type": "rect",
          "clip": true,
          "opacity": 0.22,
          "color": {
            "x-eas:item": "color",
            "default": {
              "x-eas:slot": "warn_color"
            }
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "y2": {
            "datum": {
              "x-eas:item": "high"
            }
          },
          "tooltip": [
            {
              "value": {
                "x-eas:text": "{{@label}}"
              },
              "title": "band"
            }
          ]
        }
      }
    },
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "band-ok",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          },
          {
            "filter": {
              "x-eas:expr": "{{@status}} == 'ok'"
            }
          }
        ],
        "mark": {
          "type": "rect",
          "clip": true,
          "opacity": 0.22,
          "color": {
            "x-eas:item": "color",
            "default": {
              "x-eas:slot": "ok_color"
            }
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "y2": {
            "datum": {
              "x-eas:item": "high"
            }
          },
          "tooltip": [
            {
              "value": {
                "x-eas:text": "{{@label}}"
              },
              "title": "band"
            }
          ]
        }
      }
    },
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "edge",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeWidth": 1,
          "color": {
            "x-eas:item": "color",
            "default": {
              "x-eas:slot": "muted"
            }
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          }
        }
      }
    },
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "band-label",
        "transform": [
          {
            "aggregate": [
              {
                "op": "max",
                "field": "time",
                "as": "t_end"
              }
            ]
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "bottom",
          "dx": -4,
          "dy": -2,
          "fontSize": 11,
          "color": {
            "x-eas:slot": "secondary"
          }
        },
        "encoding": {
          "x": {
            "field": "t_end",
            "type": "temporal"
          },
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "text": {
            "value": {
              "x-eas:item": "label"
            }
          }
        }
      }
    },
    {
      "x-eas:when": "target",
      "spec": {
        "name": "target",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeDash": [
            6,
            4
          ],
          "strokeWidth": 1.5,
          "color": {
            "x-eas:slot": "ink"
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:slot": "target"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "tooltip": [
            {
              "value": "personal target",
              "title": "line"
            }
          ]
        }
      }
    },
    {
      "name": "series",
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "color": {
          "x-eas:slot": "muted"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        }
      }
    },
    {
      "name": "readings",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "tooltip": [
          {
            "field": "time",
            "type": "temporal",
            "format": "%Y-%m-%d"
          },
          {
            "field": "value",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          },
          {
            "field": "band_label",
            "title": "band"
          }
        ],
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              "triangle-down",
              "diamond",
              "circle",
              "triangle-up",
              "square"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "name": "flags",
      "transform": [
        {
          "filter": "datum.status_flag != ''"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -9,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "bad_color"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "text": {
          "field": "status_flag"
        }
      }
    },
    {
      "name": "latest",
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rn"
            }
          ],
          "sort": [
            {
              "field": "time",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rn == 1"
        },
        {
          "calculate": "'latest ' + format(datum.value, '.1f')",
          "as": "latest_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -4,
        "dy": -12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "ink"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "text": {
          "field": "latest_text"
        }
      }
    }
  ],
  "transform": [
    {
      "x-eas:transform": "health-band-status",
      "value": "value",
      "bands": {
        "x-eas:slot": "bands"
      }
    }
  ]
}
