{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "lab-trend",
    "version": "1.0.0",
    "doc": "One lab analyte over time against its reference range: the range as a band (green, yellow near each limit), an optional optimal band inside it, and each result colored red out of range, yellow near a limit, green in range, grey with no range, and flagged L or H by shape and letter.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, value, warn_low?, warn_high?, warn_margin?}: an ISO date or datetime and a number, oldest first; the warn fields override the warning zone for that result"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "One lab analyte over time against its reference range: the range as a band (green, yellow near each limit), an optional optimal band inside it, and each result colored red out of range, yellow near a limit, green in range, grey with no range, and flagged L or H by shape and letter.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "low": {
        "type": "number",
        "default": null,
        "doc": "lower limit of the reference range, from the data source; null for a range with only an upper limit"
      },
      "high": {
        "type": "number",
        "default": null,
        "doc": "upper limit of the reference range, from the data source; null for a range with only a lower limit"
      },
      "show_optimal": {
        "type": "boolean",
        "default": false,
        "doc": "draw the optimal band (opt_low..opt_high)"
      },
      "opt_low": {
        "type": "number",
        "default": null,
        "doc": "lower limit of the optimal band"
      },
      "opt_high": {
        "type": "number",
        "default": null,
        "doc": "upper limit of the optimal band"
      },
      "band_label": {
        "type": "string",
        "default": "reference range",
        "doc": "tooltip name of the reference band"
      },
      "opt_label": {
        "type": "string",
        "default": "optimal range",
        "doc": "tooltip name of the optimal band"
      },
      "y_title": {
        "type": "string",
        "default": "",
        "doc": "y-axis title, e.g. LDL cholesterol (mg/dL)"
      },
      "x_format": {
        "type": "string",
        "default": "%b %Y",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "line_color": {
        "type": "string",
        "doc": "the optimal band (the theme's neutral line color)"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside each limit, as a fraction of the range width (of the one bound for a one-sided range)"
      },
      "warn_low": {
        "type": "number",
        "default": null,
        "doc": "optional: the value below which a result is yellow, replacing low + margin"
      },
      "warn_high": {
        "type": "number",
        "default": null,
        "doc": "optional: the value above which a result is yellow, replacing high - margin"
      }
    },
    "example": "examples/lab-trend.data.json",
    "health": {
      "group": "labs",
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "value": "number",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1"
          },
          "order": "time",
          "rows": [
            {
              "le": [
                "warn_low",
                "warn_high"
              ],
              "code": "range_inverted"
            }
          ]
        }
      },
      "rules": [
        {
          "le": [
            "low",
            "high"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "opt_low",
            "opt_high"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "low",
            "warn_low"
          ],
          "code": "warn_outside_range"
        },
        {
          "le": [
            "warn_high",
            "high"
          ],
          "code": "warn_outside_range"
        }
      ],
      "text_size": [
        100,
        26
      ],
      "svg_size": [
        1000,
        420
      ],
      "slots": {
        "warn_margin": "range:0:1"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 240,
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "health-status",
      "value": "value",
      "low": {
        "x-eas:slot": "low"
      },
      "high": {
        "x-eas:slot": "high"
      },
      "warn_low": {
        "x-eas:slot": "warn_low"
      },
      "warn_high": {
        "x-eas:slot": "warn_high"
      },
      "margin": {
        "x-eas:slot": "warn_margin"
      }
    }
  ],
  "layer": [
    {
      "name": "range",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "band_lo",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "band_hi",
              "as": "hi"
            },
            {
              "op": "max",
              "field": "zone_low",
              "as": "zl"
            },
            {
              "op": "max",
              "field": "zone_high",
              "as": "zh"
            }
          ]
        },
        {
          "filter": "isValid(datum.lo)"
        },
        {
          "calculate": "isValid(datum.zl) ? datum.zl : datum.lo",
          "as": "y0"
        },
        {
          "calculate": "isValid(datum.zh) ? datum.zh : datum.hi",
          "as": "y1"
        },
        {
          "filter": "true"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.22,
        "color": {
          "x-eas:slot": "ok_color"
        }
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "{{band_label}}"
            },
            "title": "range"
          }
        ]
      }
    },
    {
      "name": "warn-low",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "band_lo",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "band_hi",
              "as": "hi"
            },
            {
              "op": "max",
              "field": "zone_low",
              "as": "zl"
            },
            {
              "op": "max",
              "field": "zone_high",
              "as": "zh"
            }
          ]
        },
        {
          "filter": "isValid(datum.lo)"
        },
        {
          "calculate": "datum.lo",
          "as": "y0"
        },
        {
          "calculate": "datum.zl",
          "as": "y1"
        },
        {
          "filter": "isValid(datum.zl)"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.35,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "{{band_label}}"
            },
            "title": "range"
          }
        ]
      }
    },
    {
      "name": "warn-high",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "band_lo",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "band_hi",
              "as": "hi"
            },
            {
              "op": "max",
              "field": "zone_low",
              "as": "zl"
            },
            {
              "op": "max",
              "field": "zone_high",
              "as": "zh"
            }
          ]
        },
        {
          "filter": "isValid(datum.lo)"
        },
        {
          "calculate": "datum.zh",
          "as": "y0"
        },
        {
          "calculate": "datum.hi",
          "as": "y1"
        },
        {
          "filter": "isValid(datum.zh)"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.35,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "{{band_label}}"
            },
            "title": "range"
          }
        ]
      }
    },
    {
      "x-eas:when": "show_optimal",
      "spec": {
        "name": "optimal",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rect",
          "opacity": 0.2,
          "color": {
            "x-eas:slot": "line_color"
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:slot": "opt_low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "y2": {
            "datum": {
              "x-eas:slot": "opt_high"
            }
          },
          "tooltip": [
            {
              "value": {
                "x-eas:text": "{{opt_label}}"
              },
              "title": "range"
            }
          ]
        }
      }
    },
    {
      "name": "series",
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "color": {
          "x-eas:slot": "muted"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        }
      }
    },
    {
      "name": "results",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 100,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              "triangle-down",
              "diamond",
              "circle",
              "triangle-up",
              "square"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "time",
            "type": "temporal",
            "format": "%Y-%m-%d"
          },
          {
            "field": "value",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          },
          {
            "field": "range_text",
            "title": "range"
          }
        ]
      }
    },
    {
      "name": "flags",
      "transform": [
        {
          "filter": "datum.status_flag != ''"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -9,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "bad_color"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "text": {
          "field": "status_flag"
        }
      }
    },
    {
      "name": "latest",
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rn"
            }
          ],
          "sort": [
            {
              "field": "time",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rn == 1"
        },
        {
          "calculate": "'latest ' + datum.value",
          "as": "latest_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "top",
        "dx": -4,
        "dy": 10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "ink"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "text": {
          "field": "latest_text"
        }
      }
    }
  ]
}
