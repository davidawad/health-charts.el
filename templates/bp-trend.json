    {
      "name": "span",
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "color": {
          "x-eas:slot": "muted"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
