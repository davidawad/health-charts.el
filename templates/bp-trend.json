{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "bp-trend",
    "version": "1.0.0",
    "doc": "Blood pressure over time: each reading is a bar from diastolic to systolic, drawn over the systolic and diastolic ranges (green, yellow near each limit). Systolic and diastolic are judged separately; the reading is colored by the worse of the two: red out of range (triangle-down L low, triangle-up H high), yellow near a limit, green in range, grey when neither has a range. The ranges come from the data source via the sys_low/sys_high/dia_low/dia_high slots.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, systolic, diastolic, warn_margin?}: an ISO date or datetime and two mmHg values, oldest first; warn_margin (a fraction) overrides the warning margin for that reading"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Blood pressure over time: each reading is a bar from diastolic to systolic, drawn over the systolic and diastolic ranges (green, yellow near each limit). Systolic and diastolic are judged separately; the reading is colored by the worse of the two: red out of range (triangle-down L low, triangle-up H high), yellow near a limit, green in range, grey when neither has a range. The ranges come from the data source via the sys_low/sys_high/dia_low/dia_high slots.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "sys_low": {
        "type": "number",
        "default": null,
        "doc": "lower limit of the systolic range, from the data source; null leaves that side open (both null: that pressure is not judged)"
      },
      "sys_high": {
        "type": "number",
        "default": null,
        "doc": "upper limit of the systolic range, from the data source; null leaves that side open (both null: that pressure is not judged)"
      },
      "dia_low": {
        "type": "number",
        "default": null,
        "doc": "lower limit of the diastolic range, from the data source; null leaves that side open (both null: that pressure is not judged)"
      },
      "dia_high": {
        "type": "number",
        "default": null,
        "doc": "upper limit of the diastolic range, from the data source; null leaves that side open (both null: that pressure is not judged)"
      },
      "band_label": {
        "type": "string",
        "default": "normal range",
        "doc": "tooltip name of the shaded ranges"
      },
      "y_title": {
        "type": "string",
        "default": "Blood pressure (mmHg)"
      },
      "line_color": {
        "type": "string",
        "doc": "neutral line color (the theme's)"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside each limit, as a fraction of the range width (of the one bound for a one-sided range)"
      },
      "x_format": {
        "type": "string",
        "default": "%b %d",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "decimals": {
        "type": "integer",
        "default": null,
        "doc": "exact decimals of every displayed number (a row's own decimals wins); without it a number shows sig_figs significant figures but never fewer decimals than its reference limits show. Display only: status is judged on the number as given"
      },
      "sig_figs": {
        "type": "integer",
        "doc": "significant figures of a displayed number when decimals is not set (the theme's :sig-figs, 3)"
      }
    },
    "example": "examples/bp-trend.data.json",
    "health": {
      "group": "vitals",
      "text_size": [
        100,
        28
      ],
      "svg_size": [
        1000,
        440
      ],
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "systolic": "nonneg",
            "diastolic": "nonneg",
            "warn_margin": "?range:0:1",
            "decimals": "?range:0:8"
          },
          "order": "time",
          "rows": [
            {
              "le": [
                "diastolic",
                "systolic"
              ],
              "code": "diastolic_above_systolic"
            }
          ]
        }
      },
      "rules": [
        {
          "le": [
            "sys_low",
            "sys_high"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "dia_low",
            "dia_high"
          ],
          "code": "range_inverted"
        }
      ],
      "slots": {
        "warn_margin": "range:0:1",
        "decimals": "range:0:8",
        "sig_figs": "range:1:10"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 260,
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "health-status",
      "value": "systolic",
      "prefix": "sys",
      "low": {
        "x-eas:slot": "sys_low"
      },
      "high": {
        "x-eas:slot": "sys_high"
      },
      "margin": {
        "x-eas:slot": "warn_margin"
      }
    },
    {
      "x-eas:transform": "health-status",
      "value": "diastolic",
      "prefix": "dia",
      "low": {
        "x-eas:slot": "dia_low"
      },
      "high": {
        "x-eas:slot": "dia_high"
      },
      "margin": {
        "x-eas:slot": "warn_margin"
      }
    },
    {
      "x-eas:transform": "health-format",
      "fields": [
        "systolic",
        "diastolic"
      ],
      "decimals": {
        "x-eas:slot": "decimals"
      },
      "sig": {
        "x-eas:slot": "sig_figs"
      }
    },
    {
      "calculate": "datum.systolic_text + '/' + datum.diastolic_text",
      "as": "reading"
    },
    {
      "calculate": "(datum.sys_label == 'low' || datum.sys_label == 'high') ? datum.sys_label : (datum.dia_label == 'low' || datum.dia_label == 'high') ? datum.dia_label : (datum.sys_label == 'near limit' || datum.dia_label == 'near limit') ? 'near limit' : (datum.sys_label == 'in range' || datum.dia_label == 'in range') ? 'in range' : 'no range'",
      "as": "status_label"
    },
    {
      "calculate": "datum.status_label == 'low' ? 'L' : datum.status_label == 'high' ? 'H' : ''",
      "as": "status_flag"
    }
  ],
  "layer": [
    {
      "name": "systolic-range",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "sys_band_lo",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "sys_band_hi",
              "as": "hi"
            },
            {
              "op": "max",
              "field": "sys_zone_low",
              "as": "zl"
            },
            {
              "op": "max",
              "field": "sys_zone_high",
              "as": "zh"
            }
          ]
        },
        {
          "filter": "isValid(datum.lo)"
        },
        {
          "calculate": "isValid(datum.zl) ? datum.zl : datum.lo",
          "as": "y0"
        },
        {
          "calculate": "isValid(datum.zh) ? datum.zh : datum.hi",
          "as": "y1"
        },
        {
          "filter": "true"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.22,
        "color": {
          "x-eas:slot": "ok_color"
        }
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "{{band_label}}"
            },
            "title": "systolic range"
          }
        ]
      }
    },
    {
      "name": "systolic-warn-low",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "sys_band_lo",
