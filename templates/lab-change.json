{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "lab-change",
    "version": "1.0.0",
    "doc": "Before and after for each analyte on its own reference range: a dumbbell from the earlier result (hollow) to the later one (filled) over the range bar (green, yellow near each limit). Each marker is colored by its own status (red out of range, yellow near a limit, green in range, grey with no range) and shaped by direction. The connecting line and the word at the right say how the result moved, in neutral colors: improved (nearer the range, or inside it nearer its middle), worsened, unchanged, or no range when no direction can be decided; this is not a health status.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {analyte, unit?, before, after, ref_low?, ref_high?, warn_low?, warn_high?, warn_margin?}: two results per analyte; ref_low and ref_high come from the data source (either may be missing: one-sided; both missing: grey markers and no direction); the warn fields override the yellow zone of that analyte"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Before and after for each analyte on its own reference range: a dumbbell from the earlier result (hollow) to the later one (filled) over the range bar (green, yellow near each limit). Each marker is colored by its own status (red out of range, yellow near a limit, green in range, grey with no range) and shaped by direction. The connecting line and the word at the right say how the result moved, in neutral colors: improved (nearer the range, or inside it nearer its middle), worsened, unchanged, or no range when no direction can be decided; this is not a health status.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "line_color": {
        "type": "string",
        "doc": "the connecting line of an improved result (the theme's neutral line color)"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside each limit, as a fraction of the range width (of the one bound for a one-sided range); a row's warn_margin overrides it"
      },
      "before_title": {
        "type": "string",
        "default": "earlier",
        "doc": "legend word for the earlier result"
      },
      "after_title": {
        "type": "string",
        "default": "later",
        "doc": "legend word for the later result"
      }
    },
    "example": "examples/lab-change.data.json",
    "health": {
      "group": "labs",
      "tables": {
        "data": {
          "fields": {
            "analyte": "string",
            "unit": "?string",
            "before": "number",
            "after": "number",
            "ref_low": "?number",
            "ref_high": "?number",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1"
          },
          "rows": [
            {
              "le": [
                "ref_low",
                "ref_high"
              ],
              "code": "range_inverted"
            },
            {
              "le": [
                "ref_low",
                "warn_low"
              ],
              "code": "warn_outside_range"
            },
            {
              "le": [
                "warn_high",
                "ref_high"
              ],
              "code": "warn_outside_range"
            }
          ]
        }
      },
      "text_size": [
        100,
        22
      ],
      "svg_size": [
        1000,
        400
      ],
      "slots": {
        "warn_margin": "range:0:1"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 34
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "health-status",
      "value": "before",
      "low_field": "ref_low",
      "high_field": "ref_high",
      "margin": {
        "x-eas:slot": "warn_margin"
      },
      "prefix": "bef",
      "normalize": true
    },
    {
      "x-eas:transform": "health-status",
      "value": "after",
      "low_field": "ref_low",
      "high_field": "ref_high",
      "margin": {
        "x-eas:slot": "warn_margin"
      },
      "prefix": "aft",
      "normalize": true
    },
    {
      "calculate": "max(isValid(datum.ref_low) ? datum.ref_low - datum.before : 0, isValid(datum.ref_high) ? datum.before - datum.ref_high : 0, 0)",
      "as": "dist_before"
    },
    {
      "calculate": "max(isValid(datum.ref_low) ? datum.ref_low - datum.after : 0, isValid(datum.ref_high) ? datum.after - datum.ref_high : 0, 0)",
      "as": "dist_after"
    },
    {
      "calculate": "(isValid(datum.ref_low) && isValid(datum.ref_high)) ? abs(datum.before - (datum.ref_low + datum.ref_high) / 2) : 0",
      "as": "mid_before"
    },
    {
      "calculate": "(isValid(datum.ref_low) && isValid(datum.ref_high)) ? abs(datum.after - (datum.ref_low + datum.ref_high) / 2) : 0",
      "as": "mid_after"
    },
    {
      "calculate": "!isValid(datum.ref_low) && !isValid(datum.ref_high) ? 'no range' : datum.dist_after < datum.dist_before ? 'improved' : datum.dist_after > datum.dist_before ? 'worsened' : datum.after == datum.before ? 'unchanged' : (isValid(datum.ref_low) && isValid(datum.ref_high)) ? (datum.mid_after < datum.mid_before ? 'improved' : datum.mid_after > datum.mid_before ? 'worsened' : 'unchanged') : datum.dist_after > 0 ? 'unchanged' : 'no range'",
      "as": "verdict"
    },
    {
      "calculate": "datum.analyte + '  ' + datum.before + ' > ' + datum.after + (isValid(datum.unit) ? ' ' + datum.unit : '')",
      "as": "row_label"
    },
    {
      "calculate": "datum.bef_range_text",
      "as": "range_text"
    },
    {
      "calculate": "datum.verdict",
      "as": "verdict_text"
    }
  ],
  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "title": null,
      "sort": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 360
      }
    }
  },
  "layer": [
    {
      "name": "range",
      "transform": [
        {
          "filter": "isValid(datum.bef_pos)"
        }
      ],
      "mark": {
        "type": "rect",
        "height": {
          "band": 0.5
        },
        "opacity": 0.35,
        "color": {
          "x-eas:slot": "ok_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "title": "position within each reference range (green in range, yellow near a limit)",
          "axis": {
            "labels": false,
            "ticks": false,
            "grid": false
          },
          "field": "bef_ok_from"
        },
        "x2": {
          "field": "bef_ok_to"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "range_text",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "warn-low",
      "transform": [
        {
          "filter": "isValid(datum.bef_warn_lo_pos)"
        }
      ],
      "mark": {
        "type": "rect",
        "height": {
          "band": 0.5
        },
        "opacity": 0.6,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "datum": 0
        },
        "x2": {
          "field": "bef_warn_lo_pos"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "range_text",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "warn-high",
      "transform": [
        {
          "filter": "isValid(datum.bef_warn_hi_pos)"
        }
      ],
      "mark": {
        "type": "rect",
        "height": {
          "band": 0.5
        },
        "opacity": 0.6,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "field": "bef_warn_hi_pos"
        },
        "x2": {
          "datum": 1
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "range_text",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "improved",
      "transform": [
        {
          "filter": "isValid(datum.bef_pos) && isValid(datum.aft_pos) && (datum.verdict == 'improved')"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": {
          "x-eas:slot": "line_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "field": "bef_pos"
        },
        "x2": {
          "field": "aft_pos"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "before"
          },
          {
            "field": "after"
          },
          {
            "field": "verdict",
            "title": "direction"
          },
          {
            "field": "range_text",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "worsened",
      "transform": [
        {
          "filter": "isValid(datum.bef_pos) && isValid(datum.aft_pos) && (datum.verdict == 'worsened')"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": {
          "x-eas:slot": "ink"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "field": "bef_pos"
        },
        "x2": {
          "field": "aft_pos"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "before"
          },
          {
            "field": "after"
          },
          {
            "field": "verdict",
            "title": "direction"
          },
          {
            "field": "range_text",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "same",
      "transform": [
        {
          "filter": "isValid(datum.bef_pos) && isValid(datum.aft_pos) && (datum.verdict != 'improved' && datum.verdict != 'worsened')"
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": {
          "x-eas:slot": "muted"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "field": "bef_pos"
        },
        "x2": {
          "field": "aft_pos"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "before"
          },
          {
            "field": "after"
          },
          {
            "field": "verdict",
            "title": "direction"
          },
          {
            "field": "range_text",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "earlier",
      "transform": [
        {
          "filter": "isValid(datum.bef_pos)"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 100,
        "strokeWidth": 2.2
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "field": "bef_pos"
        },
        "color": {
          "field": "bef_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "bef_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              "triangle-down",
              "diamond",
              "circle",
              "triangle-up",
              "square"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "before",
            "title": "earlier"
          },
          {
            "field": "bef_label",
            "title": "status"
          }
        ]
      }
    },
    {
      "name": "later",
      "transform": [
        {
          "filter": "isValid(datum.aft_pos)"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "field": "aft_pos"
        },
        "color": {
          "field": "aft_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": null
        },
        "shape": {
          "field": "aft_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              "triangle-down",
              "diamond",
              "circle",
              "triangle-up",
              "square"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "after",
            "title": "later"
          },
          {
            "field": "aft_label",
            "title": "status"
          }
        ]
      }
    },
    {
      "name": "direction",
      "transform": [
        {
          "filter": "isValid(datum.bef_pos)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 11,
        "color": {
          "x-eas:slot": "secondary"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "datum": 2.08
        },
        "text": {
          "field": "verdict_text"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "verdict",
            "title": "direction"
          }
        ]
      }
    },
    {
      "name": "no-range",
      "transform": [
        {
          "filter": "!isValid(datum.bef_pos)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "color": {
          "x-eas:slot": "unknown_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              2.1
            ],
            "nice": false,
            "zero": false
          },
          "datum": 0.5
        },
        "text": {
          "value": "no range"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "before"
          },
          {
            "field": "after"
          }
        ]
      }
    }
  ]
}
