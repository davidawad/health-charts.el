{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "lipid-panel",
    "version": "1.0.0",
    "doc": "A lipid panel against goal lines: one bar per measure, a tick at its goal, an optional hollow marker for the prior draw. Each measure is judged against its own goal, a one-sided range: a 'below' goal has only an upper limit, an 'above' goal only a lower one. The bar is red when the goal is missed (low means below an 'above' goal, high above a 'below' goal), yellow when met but within the margin of the goal, green when met clear of it; the status is also written at the bar end. Goals are data.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {analyte, value, unit?, goal, direction: below|above, prior?, warn_low?, warn_high?, warn_margin?}: one row per lipid measure; goal and direction come from the data source (below: value should stay at or under the goal; above: at or over it); warn_high (below goals) or warn_low (above goals) sets the inner edge of the yellow zone and warn_margin its width as a fraction of |goal|, each overriding the slot warn_margin for that row"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A lipid panel against goal lines: one bar per measure, a tick at its goal, an optional hollow marker for the prior draw. Each measure is judged against its own goal, a one-sided range: a 'below' goal has only an upper limit, an 'above' goal only a lower one. The bar is red when the goal is missed (low means below an 'above' goal, high above a 'below' goal), yellow when met but within the margin of the goal, green when met clear of it; the status is also written at the bar end. Goals are data.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside the goal, as a fraction of |goal| (a goal is a one-sided limit); a row's warn_margin overrides it"
      },
      "x_title": {
        "type": "string",
        "default": "value",
        "doc": "x-axis title, e.g. mg/dL"
      },
      "decimals": {
        "type": "integer",
        "default": null,
        "doc": "exact decimals of every displayed number (a row's own decimals wins); without it a number shows sig_figs significant figures but never fewer decimals than its reference limits show. Display only: status is judged on the number as given"
      },
      "sig_figs": {
        "type": "integer",
        "doc": "significant figures of a displayed number when decimals is not set (the theme's :sig-figs, 3)"
      },
      "label_max": {
        "type": "integer",
        "doc": "the most characters of a row label before an ellipsis (the theme's :label-max, 28)"
      }
    },
    "example": "examples/lipid-panel.data.json",
    "health": {
      "group": "labs",
      "tables": {
        "data": {
          "fields": {
            "analyte": "string",
            "value": "nonneg",
            "unit": "?string",
            "goal": "nonneg",
            "direction": "enum:below|above",
            "prior": "?nonneg",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1",
            "decimals": "?range:0:8"
          },
          "rows": [
            {
              "le": [
                "goal",
                "warn_low"
              ],
              "code": "warn_outside_range"
            },
            {
              "le": [
                "warn_high",
                "goal"
              ],
              "code": "warn_outside_range"
            }
          ]
        }
      },
      "text_size": [
        100,
        20
      ],
      "svg_size": [
        1000,
        360
      ],
      "slots": {
        "warn_margin": "range:0:1",
        "decimals": "range:0:8",
        "sig_figs": "range:1:10",
        "label_max": "range:4:200"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 34
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "health-status",
      "value": "value",
      "low_field": "goal",
      "margin": {
        "x-eas:slot": "warn_margin"
      },
      "prefix": "abv"
    },
    {
      "x-eas:transform": "health-status",
      "value": "value",
      "high_field": "goal",
      "margin": {
        "x-eas:slot": "warn_margin"
      },
      "prefix": "bel"
    },
    {
      "x-eas:transform": "health-format",
      "fields": [
        "value",
        "goal",
        "prior"
      ],
      "decimals": {
        "x-eas:slot": "decimals"
      },
      "sig": {
        "x-eas:slot": "sig_figs"
      },
      "label_field": "analyte",
      "label_max": {
        "x-eas:slot": "label_max"
      }
    },
    {
      "calculate": "datum.direction == 'above' ? datum.abv_label : datum.bel_label",
      "as": "status_label"
    },
    {
      "calculate": "datum.direction == 'above' ? datum.abv_flag : datum.bel_flag",
      "as": "status_flag"
    },
    {
      "calculate": "datum.direction == 'above' ? datum.abv_glyph : datum.bel_glyph",
      "as": "status_glyph"
    },
    {
      "calculate": "datum.analyte_short + '  ' + datum.value_text + (isValid(datum.unit) ? ' ' + datum.unit : '') + '  (goal ' + (datum.direction == 'below' ? '<' : '>') + datum.goal_text + ')  ' + datum.status_glyph + ' ' + datum.status_label",
      "as": "row_label"
    },
    {
      "calculate": "isValid(datum.prior) ? datum.prior : datum.value",
      "as": "prior_value"
    },
    {
      "calculate": "isValid(datum.prior) ? 1 : 0",
      "as": "has_prior"
    }
  ],
  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "title": null,
      "sort": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 460,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "name": "value",
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.55
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "tickCount": 6
          },
          "field": "value",
          "title": {
            "x-eas:slot": "x_title"
          }
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "value_text",
            "title": "value"
          },
          {
            "field": "goal_text",
            "title": "goal"
          },
          {
            "field": "direction"
          },
          {
            "field": "status_label",
            "title": "status"
          }
        ]
      }
    },
    {
      "name": "goal",
      "mark": {
        "type": "tick",
        "thickness": 3,
        "color": {
          "x-eas:slot": "ink"
        },
        "orient": "vertical",
        "size": 26
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "tickCount": 6
          },
          "field": "goal"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "goal_text",
            "title": "goal"
          }
        ]
      }
    },
    {
      "name": "prior",
      "transform": [
        {
          "filter": "datum.has_prior == 1"
        }
      ],
      "mark": {
        "type": "point",
        "filled": false,
        "size": 90,
        "strokeWidth": 2,
        "color": {
          "x-eas:slot": "ink"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "tickCount": 6
          },
          "field": "prior_value"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "prior_text",
            "title": "prior draw"
          }
        ]
      }
    }
  ]
}
