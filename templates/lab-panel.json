{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "lab-panel",
    "version": "1.0.0",
    "doc": "Small multiples: one compact trend per analyte, each on its own scale with its own reference range (from the panels table) as a band, green with yellow zones near each limit; every result is colored red out of range, yellow near a limit, green in range or grey with no range, and shaped by direction. The range is data, never a template default.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, analyte, value, warn_low?, warn_high?, warn_margin?}: every result of every analyte, oldest first; panels names the analytes to draw and carries each analyte's range; the warn fields override the yellow zone of that one result"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Small multiples: one compact trend per analyte, each on its own scale with its own reference range (from the panels table) as a band, green with yellow zones near each limit; every result is colored red out of range, yellow near a limit, green in range or grey with no range, and shaped by direction. The range is data, never a template default.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "panels": {
        "type": "array",
        "required": true,
        "doc": "one object per analyte: {analyte, label, unit?, low?, high?, warn_low?, warn_high?, warn_margin?}; analyte matches data rows; low and high are that analyte's reference range from the data source (either may be missing: one-sided; both missing: grey, no range); warn_low and warn_high are the inner edges of the yellow zones, warn_margin a fraction, each overriding the slot warn_margin for that analyte"
      },
      "columns": {
        "type": "integer",
        "default": 2,
        "doc": "panels per row"
      },
      "line_color": {
        "type": "string",
        "doc": "the series line (the theme's neutral line color)"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside each limit, as a fraction of the range width (of the one bound for a one-sided range); a row's warn_margin overrides it"
      },
      "x_format": {
        "type": "string",
        "default": "%b",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      }
    },
    "example": "examples/lab-panel.data.json",
    "health": {
      "group": "labs",
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "analyte": "string",
            "value": "number",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1"
          },
          "order": "time"
        },
        "panels": {
          "fields": {
            "analyte": "string",
            "label": "string",
            "unit": "?string",
            "low": "?number",
            "high": "?number",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1"
          },
          "rows": [
            {
              "le": [
                "low",
                "high"
              ],
              "code": "range_inverted"
            },
            {
              "le": [
                "low",
                "warn_low"
              ],
              "code": "warn_outside_range"
            },
            {
              "le": [
                "warn_high",
                "high"
              ],
              "code": "warn_outside_range"
            }
          ]
        }
      },
      "text_size": [
        110,
        40
      ],
      "svg_size": [
        900,
        560
      ],
      "slots": {
        "warn_margin": "range:0:1"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "data": {
    "name": "data"
  },
  "columns": {
    "x-eas:slot": "columns"
  },
  "concat": [
    {
      "x-eas:each": "panels",
      "spec": {
        "title": {
          "text": {
            "x-eas:text": "{{@label}}{{@unit}}"
          },
          "fontSize": 11,
          "anchor": "start"
        },
        "width": 200,
        "height": 110,
        "transform": [
          {
            "filter": {
              "field": "analyte",
              "equal": {
                "x-eas:item": "analyte"
              }
            }
          },
          {
            "joinaggregate": [
              {
                "op": "min",
                "field": "value",
                "as": "vmin"
              },
              {
                "op": "max",
                "field": "value",
                "as": "vmax"
              }
            ]
          },
          {
            "calculate": {
              "x-eas:expr": "({{@}}).low"
            },
            "as": "lo"
          },
          {
            "calculate": {
              "x-eas:expr": "({{@}}).high"
            },
            "as": "hi"
          },
          {
            "calculate": {
              "x-eas:expr": "({{@}}).warn_margin"
            },
            "as": "pm"
          },
          {
            "calculate": {
              "x-eas:expr": "({{@}}).warn_low"
            },
            "as": "pwl"
          },
          {
            "calculate": {
              "x-eas:expr": "({{@}}).warn_high"
            },
            "as": "pwh"
          },
          {
            "calculate": {
              "x-eas:expr": "isValid(datum.warn_margin) ? datum.warn_margin : isValid(datum.pm) ? datum.pm : {{warn_margin}}"
            },
            "as": "m"
          },
          {
            "calculate": "!isValid(datum.lo) ? null : isValid(datum.warn_low) ? datum.warn_low : isValid(datum.pwl) ? datum.pwl : datum.lo + datum.m * (isValid(datum.hi) ? datum.hi - datum.lo : abs(datum.lo))",
            "as": "zone_low"
          },
          {
            "calculate": "!isValid(datum.hi) ? null : isValid(datum.warn_high) ? datum.warn_high : isValid(datum.pwh) ? datum.pwh : datum.hi - datum.m * (isValid(datum.lo) ? datum.hi - datum.lo : abs(datum.hi))",
            "as": "zone_high"
          },
          {
            "calculate": "!isValid(datum.value) || (!isValid(datum.lo) && !isValid(datum.hi)) ? 'no range' : isValid(datum.lo) && datum.value < datum.lo ? 'low' : isValid(datum.hi) && datum.value > datum.hi ? 'high' : (isValid(datum.zone_low) && datum.value < datum.zone_low) || (isValid(datum.zone_high) && datum.value > datum.zone_high) ? 'near limit' : 'in range'",
            "as": "status_label"
          },
          {
            "calculate": "datum.status_label == 'low' ? 'L' : datum.status_label == 'high' ? 'H' : ''",
            "as": "status_flag"
          },
          {
            "calculate": "0.1 * max(datum.vmax - datum.vmin, 1e-9)",
            "as": "pad"
          },
          {
            "calculate": "!isValid(datum.lo) && !isValid(datum.hi) ? null : isValid(datum.lo) ? datum.lo : min(datum.vmin, datum.hi, datum.zone_high) - datum.pad",
            "as": "band_lo"
          },
          {
            "calculate": "!isValid(datum.lo) && !isValid(datum.hi) ? null : isValid(datum.hi) ? datum.hi : max(datum.vmax, datum.lo, datum.zone_low) + datum.pad",
            "as": "band_hi"
          },
          {
            "calculate": "isValid(datum.lo) && isValid(datum.hi) ? datum.lo + ' to ' + datum.hi : isValid(datum.lo) ? '\u2265 ' + datum.lo : isValid(datum.hi) ? '\u2264 ' + datum.hi : 'no range'",
            "as": "range_text"
          }
        ],
        "layer": [
          {
            "name": "range",
            "transform": [
              {
                "aggregate": [
                  {
                    "op": "max",
                    "field": "band_lo",
                    "as": "lo"
                  },
                  {
                    "op": "max",
                    "field": "band_hi",
                    "as": "hi"
                  },
                  {
                    "op": "max",
                    "field": "zone_low",
                    "as": "zl"
                  },
                  {
                    "op": "max",
                    "field": "zone_high",
                    "as": "zh"
                  }
                ]
              },
              {
                "filter": "isValid(datum.lo)"
              },
              {
                "calculate": "isValid(datum.zl) ? datum.zl : datum.lo",
                "as": "y0"
              },
              {
                "calculate": "isValid(datum.zh) ? datum.zh : datum.hi",
                "as": "y1"
              },
              {
                "filter": "true"
              }
            ],
            "mark": {
              "type": "rect",
              "opacity": 0.22,
              "color": {
                "x-eas:slot": "ok_color"
              }
            },
            "encoding": {
              "y": {
                "field": "y0",
                "type": "quantitative",
                "scale": {
                  "zero": false,
                  "nice": true
                }
              },
              "y2": {
                "field": "y1"
              }
            }
          },
          {
            "name": "warn-low",
            "transform": [
              {
                "aggregate": [
                  {
                    "op": "max",
                    "field": "band_lo",
                    "as": "lo"
                  },
                  {
                    "op": "max",
                    "field": "band_hi",
                    "as": "hi"
                  },
                  {
                    "op": "max",
                    "field": "zone_low",
                    "as": "zl"
                  },
                  {
                    "op": "max",
                    "field": "zone_high",
                    "as": "zh"
                  }
                ]
              },
              {
                "filter": "isValid(datum.lo)"
              },
              {
                "calculate": "datum.lo",
                "as": "y0"
              },
              {
                "calculate": "datum.zl",
                "as": "y1"
              },
              {
                "filter": "isValid(datum.zl)"
              }
            ],
            "mark": {
              "type": "rect",
              "opacity": 0.35,
              "color": {
                "x-eas:slot": "warn_color"
              }
            },
            "encoding": {
              "y": {
                "field": "y0",
                "type": "quantitative",
                "scale": {
                  "zero": false,
                  "nice": true
                }
              },
              "y2": {
                "field": "y1"
              }
            }
          },
          {
            "name": "warn-high",
            "transform": [
              {
                "aggregate": [
                  {
                    "op": "max",
                    "field": "band_lo",
                    "as": "lo"
                  },
                  {
                    "op": "max",
                    "field": "band_hi",
                    "as": "hi"
                  },
                  {
                    "op": "max",
                    "field": "zone_low",
                    "as": "zl"
                  },
                  {
                    "op": "max",
                    "field": "zone_high",
                    "as": "zh"
                  }
                ]
              },
              {
                "filter": "isValid(datum.lo)"
              },
              {
                "calculate": "datum.zh",
                "as": "y0"
              },
              {
                "calculate": "datum.hi",
                "as": "y1"
              },
              {
                "filter": "isValid(datum.zh)"
              }
            ],
            "mark": {
              "type": "rect",
              "opacity": 0.35,
              "color": {
                "x-eas:slot": "warn_color"
              }
            },
            "encoding": {
              "y": {
                "field": "y0",
                "type": "quantitative",
                "scale": {
                  "zero": false,
                  "nice": true
                }
              },
              "y2": {
                "field": "y1"
              }
            }
          },
          {
            "name": "series",
            "mark": {
              "type": "line",
              "strokeWidth": 1.6,
              "color": {
                "x-eas:slot": "muted"
              }
            },
            "encoding": {
              "x": {
                "field": "time",
                "type": "temporal",
                "title": null,
                "axis": {
                  "grid": false,
                  "format": {
                    "x-eas:slot": "x_format"
                  },
                  "tickCount": {
                    "x-eas:slot": "x_ticks"
                  },
                  "labelFontSize": 10
                }
              },
              "y": {
                "field": "value",
                "type": "quantitative",
                "title": null,
                "scale": {
                  "zero": false,
                  "nice": true
                },
                "axis": {
                  "labelFontSize": 10,
                  "tickCount": 4
                }
              }
            }
          },
          {
            "name": "results",
            "mark": {
              "type": "point",
              "filled": true,
              "size": 50,
              "opacity": 1,
              "stroke": {
                "x-eas:slot": "surface"
              },
              "strokeWidth": 1.2
            },
            "encoding": {
              "x": {
                "field": "time",
                "type": "temporal",
                "title": null,
                "axis": {
                  "grid": false,
                  "format": {
                    "x-eas:slot": "x_format"
                  },
                  "tickCount": {
                    "x-eas:slot": "x_ticks"
                  },
                  "labelFontSize": 10
                }
              },
              "y": {
                "field": "value",
                "type": "quantitative",
                "title": null,
                "scale": {
                  "zero": false,
                  "nice": true
                },
                "axis": {
                  "labelFontSize": 10,
                  "tickCount": 4
                }
              },
              "color": {
                "field": "status_label",
                "type": "nominal",
                "scale": {
                  "domain": [
                    "low",
                    "near limit",
                    "in range",
                    "high",
                    "no range"
                  ],
                  "range": [
                    {
                      "x-eas:slot": "bad_color"
                    },
                    {
                      "x-eas:slot": "warn_color"
                    },
                    {
                      "x-eas:slot": "ok_color"
                    },
                    {
                      "x-eas:slot": "bad_color"
                    },
                    {
                      "x-eas:slot": "unknown_color"
                    }
                  ]
                },
                "legend": {
                  "title": null
                }
              },
              "shape": {
                "field": "status_label",
                "type": "nominal",
                "scale": {
                  "domain": [
                    "low",
                    "near limit",
                    "in range",
                    "high",
                    "no range"
                  ],
                  "range": [
                    "triangle-down",
                    "diamond",
                    "circle",
                    "triangle-up",
                    "square"
                  ]
                },
                "legend": null
              },
              "tooltip": [
                {
                  "field": "time",
                  "type": "temporal",
                  "format": "%Y-%m-%d"
                },
                {
                  "field": "value"
                },
                {
                  "field": "status_label",
                  "title": "status"
                },
                {
                  "field": "range_text",
                  "title": "range"
                }
              ]
            }
          },
          {
            "name": "flags",
            "transform": [
              {
                "filter": "datum.status_flag != ''"
              }
            ],
            "mark": {
              "type": "text",
              "baseline": "bottom",
              "dy": -7,
              "fontSize": 10,
              "fontWeight": "bold",
              "color": {
                "x-eas:slot": "bad_color"
              }
            },
            "encoding": {
              "x": {
                "field": "time",
                "type": "temporal",
                "title": null,
                "axis": {
                  "grid": false,
                  "format": {
                    "x-eas:slot": "x_format"
                  },
                  "tickCount": {
                    "x-eas:slot": "x_ticks"
                  },
                  "labelFontSize": 10
                }
              },
              "y": {
                "field": "value",
                "type": "quantitative",
                "title": null,
                "scale": {
                  "zero": false,
                  "nice": true
                },
                "axis": {
                  "labelFontSize": 10,
                  "tickCount": 4
                }
              },
              "text": {
                "field": "status_flag"
              }
            }
          }
        ]
      }
    }
  ]
}
