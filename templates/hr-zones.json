{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "hr-zones",
    "version": "1.0.0",
    "doc": "Time spent in each heart-rate zone as horizontal bars, with the zone's bpm bounds and its share of the total.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {zone, minutes, low, high}: one per zone, bounds in bpm"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Time spent in each heart-rate zone as horizontal bars, with the zone's bpm bounds and its share of the total.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "bar_color": {
        "type": "string",
        "default": "#d03b3b",
        "doc": "bar color"
      }
    },
    "example": "examples/hr-zones.data.json",
    "health": {
      "group": "fitness",
      "tables": {
        "data": {
          "fields": {
            "zone": "string",
            "minutes": "nonneg",
            "low": "nonneg",
            "high": "nonneg"
          },
          "rows": [
            {
              "le": [
                "low",
                "high"
              ],
              "code": "range_inverted"
            }
          ]
        }
      },
      "text_size": [
        90,
        16
      ],
      "svg_size": [
        900,
        340
      ]
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 34
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "minutes",
          "as": "total"
        }
      ]
    },
    {
      "calculate": "datum.zone + '  ' + datum.low + '-' + datum.high + ' bpm'",
      "as": "zone_label"
    },
    {
      "calculate": "datum.minutes / datum.total",
      "as": "share"
    },
    {
      "calculate": "datum.minutes + ' min  ' + format(datum.share * 100, '.0f') + '%'",
      "as": "readout"
    }
  ],
  "layer": [
    {
      "name": "zones",
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.7
        },
        "color": {
          "x-eas:slot": "bar_color"
        }
      },
      "encoding": {
        "y": {
          "field": "zone_label",
          "type": "ordinal",
          "title": null,
          "sort": {
            "field": "low",
            "order": "ascending"
          },
          "axis": {
            "domain": false,
            "ticks": false,
            "labelLimit": 260
          }
        },
        "x": {
          "field": "minutes",
          "type": "quantitative",
          "title": "minutes in zone",
          "scale": {
            "zero": true
          }
        },
        "tooltip": [
          {
            "field": "zone_label",
            "title": "zone"
          },
          {
            "field": "readout",
            "title": "time"
          }
        ]
      }
    },
    {
      "name": "pad",
      "transform": [
        {
          "calculate": "datum.minutes * 1.3",
          "as": "padded"
        }
      ],
      "mark": {
        "type": "point",
        "opacity": 0
      },
      "encoding": {
        "y": {
          "field": "zone_label",
          "type": "ordinal",
          "sort": {
            "field": "low",
            "order": "ascending"
          }
        },
        "x": {
          "field": "padded",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "readout",
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 4,
        "fontSize": 11,
        "color": {
          "x-eas:slot": "ink"
        }
      },
      "encoding": {
        "y": {
          "field": "zone_label",
          "type": "ordinal",
          "sort": {
            "field": "low",
            "order": "ascending"
          }
        },
        "x": {
          "field": "minutes",
          "type": "quantitative"
        },
        "text": {
          "field": "readout"
        }
      }
    }
  ]
}
