{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart strip: every draw of every marker on its own range scale (0 = reference low, 1 = reference high); earlier draws as grey ticks, the latest as a status shape with its glyph and word beside it. Adapted from the Vega-Lite strip plot (tick_strip).",
  "width": {{width}},
  "height": {{height}},
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 14,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": {{colors.grid}},
      "domainColor": {{colors.axis}}, "tickColor": {{colors.axis}}
    },
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 110, "columnPadding": 18,
      "layout": {"bottom": {"anchor": "start", "direction": "vertical", "margin": 6}}
    }
  },
  "data": {"values": {{data}}},
  "encoding": {
    "y": {
      "field": "label", "type": "nominal", "title": null,
      "scale": {"domain": {{y.domain}}, "paddingInner": 0.3, "paddingOuter": 0.2},
      "axis": {"domain": false, "ticks": false, "labelPadding": 10, "labelFontSize": 12.5,
               "labelColor": {{colors.ink}}, "labelLimit": 220}
    }
  },
  "layer": [
    {
      "transform": [{"filter": "datum.latest === 1 && isValid(datum.ref_x)"}],
      "mark": {"type": "bar", "height": {"band": 0.62}, "opacity": {{overlays.bands.0.opacity}}},
      "encoding": {
        "x": {"field": "ref_x", "type": "quantitative",
              "scale": {"domain": {{x.domain}}, "nice": false, "zero": false},
              "title": {{x.title}},
              "axis": {"values": [0, 1], "labelExpr": "datum.value === 0 ? 'reference low' : 'reference high'",
                       "grid": false, "labelPadding": 6, "domain": false}},
        "x2": {"field": "ref_x2"},
        "fill": {"datum": {{overlays.bands.0.label}}, "type": "nominal",
                 "scale": {"domain": {{overlays.bands.label}}, "range": {{overlays.bands.color}}},
                 "legend": {"symbolType": "square", "symbolOpacity": 0.6}},
        "tooltip": [{"field": "label", "title": "marker"}, {"field": "ref_range", "title": "reference"}]
      }
    },
    {
      "transform": [{"filter": "datum.latest === 1 && isValid(datum.opt_x)"}],
      "mark": {"type": "bar", "height": {"band": 0.62}, "opacity": {{overlays.bands.1.opacity}}},
      "encoding": {
        "x": {"field": "opt_x", "type": "quantitative"},
        "x2": {"field": "opt_x2"},
        "fill": {"datum": {{overlays.bands.1.label}}, "type": "nominal"},
        "tooltip": [{"field": "label", "title": "marker"}, {"field": "opt_range", "title": "optimal"}]
      }
    },
    {
      "transform": [{"filter": "datum.latest === 0"}],
      "mark": {"type": "tick", "thickness": 2, "bandSize": 20, "color": {{colors.secondary}}, "opacity": 0.55},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "date", "type": "temporal", "format": "%Y-%m-%d", "formatType": "utc"},
          {"field": "value_label", "title": "value"},
          {"field": "status_label", "title": "status"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.latest === 1"}],
      "mark": {"type": "point", "filled": true, "size": 150, "opacity": 1, "stroke": {{colors.surface}}, "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "color": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": {{legend.label}}, "range": {{legend.color}}}},
        "shape": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": {{legend.label}}, "range": {{legend.shape}}}},
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "date", "type": "temporal", "format": "%Y-%m-%d", "formatType": "utc", "title": "latest draw"},
          {"field": "value_label", "title": "value"},
          {"field": "status_label", "title": "status"},
          {"field": "ref_range", "title": "reference"},
          {"field": "opt_range", "title": "optimal"},
          {"field": "draws", "title": "draws"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.latest === 1"}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 14, "fontSize": 12.5, "color": {{colors.ink}}},
      "encoding": {
        "x": {"datum": {{x.domain.1}}, "type": "quantitative"},
        "text": {"field": "latest_label"}
      }
    }
  ]
}
