{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart trend: one marker's draws as status shapes (glyph + word in the legend), a 3-draw rolling mean (solid) and a least-squares linear trend (dashed) whose slope is written out, reference and optimal bands shaded. Adapted from the Vega-Lite rolling-mean line (layer_line_rolling_mean_point_raw).",
  "width": {{width}},
  "height": {{height}},
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 12,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": {{colors.grid}},
      "domainColor": {{colors.axis}}, "tickColor": {{colors.axis}}
    },
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 110, "columnPadding": 18,
      "layout": {"bottom": {"anchor": "start", "direction": "vertical", "margin": 4}}
    }
  },
  "data": {"values": {{data}}},
  "encoding": {
    "x": {
      "field": "date", "type": "temporal", "title": {{x.title}},
      "scale": {"type": "utc", "domain": {{x.domain_ms}}},
      "axis": {"values": {{x.ticks.ms}}, "format": {{x.tick_format}}, "formatType": "utc", "grid": false, "labelPadding": 6}
    }
  },
  "layer": [
    {
      "data": {"values": {{overlays.bands}}},
      "mark": {"type": "rect"},
      "encoding": {
        "x": null,
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": {{y.domain}}, "nice": false, "zero": false}},
        "y2": {"field": "y2"},
        "fill": {
          "field": "label", "type": "nominal",
          "scale": {"domain": {{overlays.bands.label}}, "range": {{overlays.bands.color}}},
          "legend": {"symbolType": "square", "symbolOpacity": 0.45}
        },
        "opacity": {"field": "opacity", "type": "quantitative", "scale": null, "legend": null}
      }
    },
    {
      "transform": [{"filter": "isValid(datum.fit)"}],
      "mark": {"type": "line", "strokeWidth": 2, "color": {{colors.ink}}, "opacity": 0.85},
      "encoding": {
        "y": {"field": "fit", "type": "quantitative", "title": {{y.title}},
              "scale": {"domain": {{y.domain}}, "nice": false, "zero": false},
              "axis": {"tickCount": 6, "labelPadding": 4}},
        "strokeDash": {"datum": "linear trend", "type": "nominal",
                       "scale": {"domain": ["3-draw rolling mean", "linear trend"], "range": [[1, 0], [6, 5]]},
                       "legend": {"symbolType": "stroke", "symbolStrokeColor": {{colors.ink}}, "symbolStrokeWidth": 2, "symbolSize": 400, "labelLimit": 240}}
      }
    },
    {
      "mark": {"type": "line", "strokeWidth": 3, "color": {{colors.muted}}, "interpolate": "monotone"},
      "encoding": {
        "y": {"field": "roll", "type": "quantitative"},
        "strokeDash": {"datum": "3-draw rolling mean", "type": "nominal"}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 110, "opacity": 1, "stroke": {{colors.surface}}, "strokeWidth": 1.5},
      "encoding": {
        "y": {"field": "value", "type": "quantitative"},
        "color": {
          "field": "status_label", "type": "nominal",
          "scale": {"domain": {{legend.label}}, "range": {{legend.color}}}
        },
        "shape": {
          "field": "status_label", "type": "nominal",
          "scale": {"domain": {{legend.label}}, "range": {{legend.shape}}}
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "format": "%Y-%m-%d", "formatType": "utc"},
          {"field": "value_label", "title": "value"},
          {"field": "status_label", "title": "status"},
          {"field": "roll", "title": "3-draw mean"},
          {"field": "fit", "title": "trend line"}
        ]
      }
    },
    {
      "data": {"values": {{overlays.annotations}}},
      "mark": {"type": "text", "align": "right", "baseline": "bottom", "dx": -4, "dy": -12,
               "fontSize": 12.5, "fontWeight": "bold", "color": {{colors.ink}}},
      "encoding": {
        "y": {"field": "value", "type": "quantitative"},
        "text": {"field": "text"}
      }
    }
  ]
}
