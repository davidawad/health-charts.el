{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart staleness: days since each indicator's draw as horizontal bars colored by state (glyph + word in the legend and at each bar end), with the due and stale thresholds as labeled vertical lines.",
  "width": {{width}},
  "height": {{height}},
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 30,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": {{colors.grid}},
      "domainColor": {{colors.axis}}, "tickColor": {{colors.axis}}
    },
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 140, "columnPadding": 18
    }
  },
  "data": {"values": {{data}}},
  "encoding": {
    "y": {
      "field": "label", "type": "nominal", "title": {{y.title}},
      "scale": {"domain": {{y.domain}}, "paddingInner": 0.38, "paddingOuter": 0.2},
      "axis": {"labelFontSize": 12, "labelColor": {{colors.ink}}, "labelPadding": 10,
               "ticks": false, "domain": false, "labelLimit": 220}
    }
  },
  "layer": [
    {
      "data": {"values": {{overlays.thresholds}}},
      "layer": [
        {
          "mark": {"type": "rule", "strokeWidth": 1.5, "strokeDash": [5, 4]},
          "encoding": {
            "x": {"field": "value", "type": "quantitative"}, "y": null,
            "stroke": {"field": "color", "type": "nominal", "scale": null}
          }
        },
        {
          "mark": {"type": "text", "align": "center", "baseline": "bottom", "dy": -6,
                   "fontSize": 11.5, "fontWeight": "bold"},
          "encoding": {
            "x": {"field": "value", "type": "quantitative"}, "y": {"value": 0},
            "text": {"field": "label"},
            "fill": {"field": "color", "type": "nominal", "scale": null}
          }
        }
      ]
    },
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 2},
      "encoding": {
        "x": {
          "field": "bar", "type": "quantitative", "title": {{x.title}},
          "scale": {"domain": {{x.domain}}, "nice": false, "zero": true},
          "axis": {"tickCount": 6, "grid": true, "labelPadding": 4, "titlePadding": 8}
        },
        "color": {
          "field": "state_label", "type": "nominal",
          "scale": {"domain": {{legend.label}}, "range": {{legend.color}}},
          "legend": {"symbolType": "square"}
        },
        "tooltip": [
          {"field": "label", "title": "indicator"},
          {"field": "date", "title": "drawn"},
          {"field": "days_label", "title": "since"},
          {"field": "state_label", "title": "state"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 7,
               "fontSize": 11.5, "color": {{colors.ink}}},
      "encoding": {"x": {"field": "bar", "type": "quantitative"}, "text": {"field": "text"}}
    }
  ]
}
