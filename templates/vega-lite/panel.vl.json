{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart panel: small multiples, one compact time series per marker on its own y scale, reference and optimal bands shaded, points by status (glyph + word in the legend), latest value and status in each cell's header.",
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 16,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 10.5,
      "titleFontSize": 11, "titleFontWeight": "normal", "gridColor": {{colors.grid}},
      "domainColor": {{colors.axis}}, "tickColor": {{colors.axis}}
    },
    "header": {
      "title": null, "labelAnchor": "start", "labelAlign": "left", "labelFontSize": 12.5,
      "labelFontWeight": "bold", "labelColor": {{colors.ink}}, "labelPadding": 6
    },
    "facet": {"spacing": {"row": 26, "column": 34}},
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 110, "columnPadding": 18,
      "layout": {"bottom": {"anchor": "start", "direction": "vertical", "margin": 6}}
    }
  },
  "data": {"values": {{data}}},
  "facet": {
    "field": "panel", "type": "nominal",
    "sort": {"field": "panel_index", "op": "min"},
    "header": {"labelLimit": 0}
  },
  "columns": {{layout.columns}},
  "resolve": {"scale": {"y": "independent"}, "axis": {"x": "independent"}},
  "spec": {
    "width": {{layout.cell_width}},
    "height": {{layout.cell_height}},
    "encoding": {
      "x": {
        "field": "date", "type": "temporal", "title": null,
        "scale": {"type": "utc", "domain": {{x.domain_ms}}},
        "axis": {"values": {{x.ticks.ms}}, "format": {{x.tick_format}}, "formatType": "utc", "grid": false,
                 "labelPadding": 4}
      }
    },
    "layer": [
      {
        "mark": {"type": "rule", "opacity": 0},
        "encoding": {
          "y": {"field": "y_min", "type": "quantitative", "aggregate": "min", "title": null,
                "scale": {"nice": false, "zero": false},
                "axis": {"tickCount": 3, "labelPadding": 3, "domain": false, "ticks": false}},
          "y2": {"field": "y_max", "aggregate": "max"},
          "x": null
        }
      },
      {
        "transform": [{"filter": "isValid(datum.ref_y) && isValid(datum.ref_y2)"}],
        "mark": {"type": "rect", "opacity": {{overlays.bands.0.opacity}}},
        "encoding": {
          "x": null,
          "y": {"field": "ref_y", "type": "quantitative", "aggregate": "min"},
          "y2": {"field": "ref_y2", "aggregate": "max"},
          "fill": {"datum": {{overlays.bands.0.label}}, "type": "nominal",
                   "scale": {"domain": {{overlays.bands.label}}, "range": {{overlays.bands.color}}},
                   "legend": {"symbolType": "square", "encode": {"symbols": {"update": {"opacity": {"value": 0.6}}}}}}
        }
      },
      {
        "transform": [{"filter": "isValid(datum.opt_y) && isValid(datum.opt_y2)"}],
        "mark": {"type": "rect", "opacity": {{overlays.bands.1.opacity}}},
        "encoding": {
          "x": null,
          "y": {"field": "opt_y", "type": "quantitative", "aggregate": "min"},
          "y2": {"field": "opt_y2", "aggregate": "max"},
          "fill": {"datum": {{overlays.bands.1.label}}, "type": "nominal"}
        }
      },
      {
        "mark": {"type": "line", "strokeWidth": 1.6, "color": {{colors.muted}}, "interpolate": "linear"},
        "encoding": {"y": {"field": "value", "type": "quantitative"}}
      },
      {
        "mark": {"type": "point", "filled": true, "size": 52, "opacity": 1, "stroke": {{colors.surface}}, "strokeWidth": 1},
        "encoding": {
          "y": {"field": "value", "type": "quantitative"},
          "color": {"field": "status_label", "type": "nominal",
                    "scale": {"domain": {{legend.label}}, "range": {{legend.color}}}},
          "shape": {"field": "status_label", "type": "nominal",
                    "scale": {"domain": {{legend.label}}, "range": {{legend.shape}}}},
          "tooltip": [
            {"field": "label", "title": "marker"},
            {"field": "date", "title": "drawn"},
            {"field": "value_label", "title": "value"},
            {"field": "status_label", "title": "status"}
          ]
        }
      },
      {
        "transform": [{"filter": "datum.latest == 1"}],
        "mark": {"type": "text", "align": "right", "baseline": "bottom", "fontSize": 11.5,
                 "x": {{layout.cell_width}}, "y": -7, "color": {{colors.secondary}}},
        "encoding": {"text": {"field": "latest_label"}, "x": null}
      }
    ]
  }
}
