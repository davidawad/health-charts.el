{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart delta: percent change per marker between two draws, diverging bars from 0 colored by verdict (glyph + word in the legend), each bar labeled with its change and its before and after values.",
  "width": {{width}},
  "height": {{height}},
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 14,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": {{colors.grid}},
      "domainColor": {{colors.axis}}, "tickColor": {{colors.axis}}
    },
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 140, "columnPadding": 18
    }
  },
  "data": {"values": {{data}}},
  "encoding": {
    "y": {
      "field": "label", "type": "nominal", "title": {{y.title}},
      "scale": {"domain": {{y.domain}}, "paddingInner": 0.38, "paddingOuter": 0.2},
      "axis": {"labelFontSize": 12, "labelColor": {{colors.ink}}, "labelPadding": 10,
               "ticks": false, "domain": false, "labelLimit": 220}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadius": 2},
      "encoding": {
        "x": {
          "field": "pct", "type": "quantitative", "title": {{x.title}},
          "scale": {"domain": {{x.domain}}, "nice": false, "zero": true},
          "axis": {"tickCount": 6, "labelExpr": "datum.label + '%'", "grid": true, "labelPadding": 4,
                   "domain": false, "titlePadding": 8}
        },
        "x2": {"datum": 0},
        "color": {
          "field": "verdict_label", "type": "nominal",
          "scale": {"domain": {{legend.label}}, "range": {{legend.color}}},
          "legend": {"symbolType": "square"}
        },
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "pct_label", "title": "change"},
          {"field": "value_label", "title": "values"},
          {"field": "verdict_label", "title": "verdict"}
        ]
      }
    },
    {
      "data": {"values": {{overlays.thresholds}}},
      "mark": {"type": "rule", "strokeWidth": 1.5, "color": {{colors.secondary}}},
      "encoding": {"x": {"field": "value", "type": "quantitative"}, "y": null}
    },
    {
      "transform": [{"filter": "datum.side === 'pos'"}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 7,
               "fontSize": 11.5, "color": {{colors.ink}}},
      "encoding": {"x": {"field": "pct", "type": "quantitative"}, "text": {"field": "text"}}
    },
    {
      "transform": [{"filter": "datum.side === 'neg'"}],
      "mark": {"type": "text", "align": "right", "baseline": "middle", "dx": -7,
               "fontSize": 11.5, "color": {{colors.ink}}},
      "encoding": {"x": {"field": "pct", "type": "quantitative"}, "text": {"field": "text"}}
    }
  ]
}
