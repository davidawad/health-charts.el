{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart lollipop: one marker's draws as stems from its target limit to the value, status shapes at the tips (glyph + word in the legend), each labeled with its distance past the limit. A rule plus point layer as in the Vega-Lite ranged dot plot (layer_ranged_dot).",
  "width": {{width}},
  "height": {{height}},
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 12,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": {{colors.grid}},
      "domainColor": {{colors.axis}}, "tickColor": {{colors.axis}}
    },
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 110, "columnPadding": 18,
      "layout": {"bottom": {"anchor": "start", "direction": "vertical", "margin": 4}}
    }
  },
  "data": {"values": {{data}}},
  "encoding": {
    "x": {
      "field": "date", "type": "temporal", "title": {{x.title}},
      "scale": {"type": "utc", "domain": {{x.domain_ms}}},
      "axis": {"values": {{x.ticks.ms}}, "format": {{x.tick_format}}, "formatType": "utc", "grid": false, "labelPadding": 6}
    }
  },
  "layer": [
    {
      "data": {"values": {{overlays.bands}}},
      "mark": {"type": "rect"},
      "encoding": {
        "x": null,
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": {{y.domain}}, "nice": false, "zero": false}},
        "y2": {"field": "y2"},
        "fill": {
          "field": "label", "type": "nominal",
          "scale": {"domain": {{overlays.bands.label}}, "range": {{overlays.bands.color}}},
          "legend": {"symbolType": "square", "symbolOpacity": 0.45}
        },
        "opacity": {"field": "opacity", "type": "quantitative", "scale": null, "legend": null}
      }
    },
    {
      "data": {"values": {{overlays.thresholds}}},
      "mark": {"type": "rule", "strokeWidth": 1.5, "strokeDash": [5, 4], "color": {{colors.secondary}}},
      "encoding": {
        "x": null,
        "y": {"field": "value", "type": "quantitative", "title": {{y.title}},
              "scale": {"domain": {{y.domain}}, "nice": false, "zero": false},
              "axis": {"tickCount": 6, "labelPadding": 4}}
      }
    },
    {
      "data": {"values": {{overlays.thresholds}}},
      "mark": {"type": "text", "align": "left", "baseline": "top", "dx": 6, "dy": 5,
               "fontSize": 11.5, "color": {{colors.secondary}}},
      "encoding": {
        "x": {"value": 0},
        "y": {"field": "value", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "mark": {"type": "rule", "strokeWidth": 3, "opacity": 0.85},
      "encoding": {
        "y": {"field": "base", "type": "quantitative"},
        "y2": {"field": "value"},
        "color": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": {{legend.label}}, "range": {{legend.color}}}, "legend": null}
      }
    },
    {
      "mark": {"type": "point", "filled": true, "size": 150, "opacity": 1, "stroke": {{colors.surface}}, "strokeWidth": 1.5},
      "encoding": {
        "y": {"field": "value", "type": "quantitative"},
        "color": {
          "field": "status_label", "type": "nominal",
          "scale": {"domain": {{legend.label}}, "range": {{legend.color}}}
        },
        "shape": {
          "field": "status_label", "type": "nominal",
          "scale": {"domain": {{legend.label}}, "range": {{legend.shape}}}
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "format": "%Y-%m-%d", "formatType": "utc"},
          {"field": "value_label", "title": "value"},
          {"field": "status_label", "title": "status"},
          {"field": "gap_label", "title": "vs limit"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.gap >= 0"}],
      "mark": {"type": "text", "align": "center", "baseline": "bottom", "dy": -12, "fontSize": 12, "color": {{colors.ink}}},
      "encoding": {"y": {"field": "value", "type": "quantitative"}, "text": {"field": "gap_label"}}
    },
    {
      "transform": [{"filter": "datum.gap < 0"}],
      "mark": {"type": "text", "align": "center", "baseline": "top", "dy": 12, "fontSize": 12, "color": {{colors.ink}}},
      "encoding": {"y": {"field": "value", "type": "quantitative"}, "text": {"field": "gap_label"}}
    }
  ]
}
