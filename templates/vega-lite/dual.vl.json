{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart dual: two related markers over time, one per axis (left and right, titles and lines in the marker's color), points by status (glyph + word in the legend), each marker's upper reference limit dashed on its own axis. Adapted from the Vega-Lite dual-axis plot (layer_dual_axis).",
  "width": {{width}},
  "height": {{height}},
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 12,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 11.5,
      "titleFontSize": 12, "titleFontWeight": "bold", "gridColor": {{colors.grid}},
      "domainColor": {{colors.axis}}, "tickColor": {{colors.axis}}
    },
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 110, "columnPadding": 18
    }
  },
  "data": {"values": {{data}}},
  "encoding": {
    "x": {
      "field": "date", "type": "temporal", "title": {{x.title}},
      "scale": {"type": "utc", "domain": {{x.domain_ms}}},
      "axis": {"values": {{x.ticks.ms}}, "format": {{x.tick_format}}, "formatType": "utc", "grid": false, "labelPadding": 6,
               "titleFontWeight": "normal"}
    }
  },
  "resolve": {"scale": {"y": "independent"}},
  "layer": [
    {
      "transform": [{"filter": "datum.axis === 'left'"}],
      "mark": {"type": "line", "strokeWidth": 2.5, "color": {{layout.left.color}}},
      "encoding": {
        "y": {"field": "value", "type": "quantitative", "title": {{layout.left.title}},
              "scale": {"domain": {{layout.left.domain}}, "nice": false, "zero": false},
              "axis": {"orient": "left", "tickCount": 6, "labelPadding": 4, "titleColor": {{layout.left.color}},
                       "titlePadding": 8, "domainColor": {{layout.left.color}}, "tickColor": {{layout.left.color}}}}
      }
    },
    {
      "transform": [{"filter": "datum.axis === 'right'"}],
      "mark": {"type": "line", "strokeWidth": 2.5, "strokeDash": [7, 4], "color": {{layout.right.color}}},
      "encoding": {
        "y": {"field": "value", "type": "quantitative", "title": {{layout.right.title}},
              "scale": {"domain": {{layout.right.domain}}, "nice": false, "zero": false},
              "axis": {"orient": "right", "tickCount": 6, "labelPadding": 4, "grid": false, "titleColor": {{layout.right.color}},
                       "titlePadding": 8, "domainColor": {{layout.right.color}}, "tickColor": {{layout.right.color}}}}
      }
    },
    {
      "data": {"values": {{overlays.thresholds}}},
      "transform": [{"filter": "datum.axis === 'left'"}],
      "mark": {"type": "rule", "strokeWidth": 1.5, "strokeDash": [2, 4], "color": {{layout.left.color}}, "opacity": 0.8},
      "encoding": {
        "x": null,
        "y": {"field": "value", "type": "quantitative",
              "scale": {"domain": {{layout.left.domain}}, "nice": false, "zero": false}, "axis": null}
      }
    },
    {
      "data": {"values": {{overlays.thresholds}}},
      "transform": [{"filter": "datum.axis === 'right'"}],
      "mark": {"type": "rule", "strokeWidth": 1.5, "strokeDash": [2, 4], "color": {{layout.right.color}}, "opacity": 0.8},
      "encoding": {
        "x": null,
        "y": {"field": "value", "type": "quantitative",
              "scale": {"domain": {{layout.right.domain}}, "nice": false, "zero": false}, "axis": null}
      }
    },
    {
      "data": {"values": {{overlays.thresholds}}},
      "transform": [{"filter": "datum.axis === 'left'"}],
      "mark": {"type": "text", "align": "left", "baseline": "bottom", "dx": 6, "dy": -3,
               "fontSize": 11.5, "color": {{layout.left.color}}},
      "encoding": {
        "x": {"value": 0},
        "y": {"field": "value", "type": "quantitative",
              "scale": {"domain": {{layout.left.domain}}, "nice": false, "zero": false}, "axis": null},
        "text": {"field": "label"}
      }
    },
    {
      "data": {"values": {{overlays.thresholds}}},
      "transform": [{"filter": "datum.axis === 'right'"}],
      "mark": {"type": "text", "align": "left", "baseline": "bottom", "dx": 6, "dy": -3,
               "fontSize": 11.5, "color": {{layout.right.color}}},
      "encoding": {
        "x": {"value": 0},
        "y": {"field": "value", "type": "quantitative",
              "scale": {"domain": {{layout.right.domain}}, "nice": false, "zero": false}, "axis": null},
        "text": {"field": "label"}
      }
    },
    {
      "transform": [{"filter": "datum.axis === 'left'"}],
      "mark": {"type": "point", "filled": true, "size": 120, "opacity": 1, "stroke": {{colors.surface}}, "strokeWidth": 1.5},
      "encoding": {
        "y": {"field": "value", "type": "quantitative",
              "scale": {"domain": {{layout.left.domain}}, "nice": false, "zero": false}, "axis": null},
        "color": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": {{legend.label}}, "range": {{legend.color}}}},
        "shape": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": {{legend.label}}, "range": {{legend.shape}}}},
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "date", "type": "temporal", "format": "%Y-%m-%d", "formatType": "utc"},
          {"field": "value_label", "title": "value"},
          {"field": "status_label", "title": "status"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.axis === 'right'"}],
      "mark": {"type": "point", "filled": true, "size": 120, "opacity": 1, "stroke": {{colors.surface}}, "strokeWidth": 1.5},
      "encoding": {
        "y": {"field": "value", "type": "quantitative",
              "scale": {"domain": {{layout.right.domain}}, "nice": false, "zero": false}, "axis": null},
        "color": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": {{legend.label}}, "range": {{legend.color}}}},
        "shape": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": {{legend.label}}, "range": {{legend.shape}}}},
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "date", "type": "temporal", "format": "%Y-%m-%d", "formatType": "utc"},
          {"field": "value_label", "title": "value"},
          {"field": "status_label", "title": "status"}
        ]
      }
    }
  ]
}
