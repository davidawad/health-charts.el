{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart heatmap: markers (rows) by draw dates (columns), each cell colored by status with its glyph and value drawn in it (glyph and word in the legend).",
  "width": {{width}},
  "height": {{height}},
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": {{colors.surface}},
  "title": {
    "text": {{title}}, "subtitle": {{subtitle}}, "anchor": "start", "offset": 14,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": {{colors.ink}}, "subtitleColor": {{colors.secondary}}
  },
  "config": {
    "font": {{font}},
    "view": {"stroke": null},
    "axis": {
      "labelColor": {{colors.secondary}}, "titleColor": {{colors.secondary}}, "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": {{colors.grid}},
      "domain": false, "ticks": false
    },
    "legend": {
      "labelColor": {{colors.secondary}}, "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 150, "columnPadding": 18
    }
  },
  "data": {"values": {{data}}},
  "encoding": {
    "x": {
      "field": "date", "type": "ordinal", "title": null,
      "scale": {"domain": {{x.domain}}, "paddingInner": 0.08, "paddingOuter": 0},
      "axis": {"orient": "top", "labelAngle": 0, "labelPadding": 8, "labelOverlap": "greedy",
               "labelExpr": "utcFormat(toDate(datum.value), '%b %Y')"}
    },
    "y": {
      "field": "label", "type": "nominal", "title": null,
      "scale": {"domain": {{y.domain}}, "paddingInner": 0.1, "paddingOuter": 0},
      "axis": {"labelPadding": 10, "labelFontSize": 12.5, "labelColor": {{colors.ink}}, "labelLimit": 220}
    }
  },
  "layer": [
    {
      "mark": {"type": "rect", "cornerRadius": 3, "opacity": 0.9},
      "encoding": {
        "fill": {
          "field": "status_label", "type": "nominal",
          "scale": {"domain": {{legend.label}}, "range": {{legend.color}}},
          "legend": {"symbolType": "square", "symbolOpacity": 0.9}
        },
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "date", "title": "drawn"},
          {"field": "value_label", "title": "value"},
          {"field": "status_label", "title": "status"}
        ]
      }
    },
    {
      "mark": {"type": "text", "fontSize": 12.5, "fontWeight": "bold", "baseline": "middle", "align": "center", "color": {{colors.surface}}},
      "encoding": {
        "text": {"field": "cell_label"}
      }
    }
  ]
}
