{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "lab-results",
    "version": "1.0.0",
    "doc": "Latest result of many analytes, each placed within its own reference range: the range is the bar (green, yellow near each limit), the result a marker colored red out of range, yellow near a limit, green in range and grey when there is no range.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {analyte, value, unit?, ref_low?, ref_high?, warn_low?, warn_high?, warn_margin?}: one latest result per analyte; ref_low and ref_high come from the data source (either may be missing, both missing draws no bar and is grey)"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Latest result of many analytes, each placed within its own reference range: the range is the bar (green, yellow near each limit), the result a marker colored red out of range, yellow near a limit, green in range and grey when there is no range.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside each limit, as a fraction of the range width (one bound for a one-sided range)"
      }
    },
    "example": "examples/lab-results.data.json",
    "health": {
      "group": "labs",
      "tables": {
        "data": {
          "fields": {
            "analyte": "string",
            "value": "number",
            "unit": "?string",
            "ref_low": "?number",
            "ref_high": "?number",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1"
          },
          "rows": [
            {
              "le": [
                "ref_low",
                "ref_high"
              ],
              "code": "range_inverted"
            },
            {
              "le": [
                "ref_low",
                "warn_low"
              ],
              "code": "warn_outside_range"
            },
            {
              "le": [
                "warn_high",
                "ref_high"
              ],
              "code": "warn_outside_range"
            }
          ]
        }
      },
      "text_size": [
        100,
        24
      ],
      "svg_size": [
        1000,
        440
      ],
      "slots": {
        "warn_margin": "range:0:1"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 30
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "health-status",
      "value": "value",
      "low_field": "ref_low",
      "high_field": "ref_high",
      "margin": {
        "x-eas:slot": "warn_margin"
      },
      "normalize": true
    },
    {
      "calculate": "datum.analyte + '  ' + datum.value + (isValid(datum.unit) ? ' ' + datum.unit : '')",
      "as": "row_label"
    },
    {
      "calculate": "datum.range_text + (isValid(datum.unit) ? ' ' + datum.unit : '')",
      "as": "range_text_unit"
    }
  ],
  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "title": null,
      "sort": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 320
      }
    }
  },
  "layer": [
    {
      "name": "range",
      "transform": [
        {
          "filter": "isValid(datum.pos)"
        }
      ],
      "mark": {
        "type": "rect",
        "height": {
          "band": 0.5
        },
        "opacity": 0.35,
        "color": {
          "x-eas:slot": "ok_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ],
            "nice": false,
            "zero": false
          },
          "title": "range bar: green in range, yellow near a limit",
          "axis": {
            "labels": false,
            "ticks": false,
            "grid": false
          },
          "field": "ok_from"
        },
        "x2": {
          "field": "ok_to"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "range_text_unit",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "warn-low",
      "transform": [
        {
          "filter": "isValid(datum.warn_lo_pos)"
        }
      ],
      "mark": {
        "type": "rect",
        "height": {
          "band": 0.5
        },
        "opacity": 0.6,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ],
            "nice": false,
            "zero": false
          },
          "datum": 0
        },
        "x2": {
          "field": "warn_lo_pos"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "range_text_unit",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "warn-high",
      "transform": [
        {
          "filter": "isValid(datum.warn_hi_pos)"
        }
      ],
      "mark": {
        "type": "rect",
        "height": {
          "band": 0.5
        },
        "opacity": 0.6,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ],
            "nice": false,
            "zero": false
          },
          "field": "warn_hi_pos"
        },
        "x2": {
          "datum": 1
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "range_text_unit",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "result",
      "transform": [
        {
          "filter": "isValid(datum.pos)"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ],
            "nice": false,
            "zero": false
          },
          "field": "pos"
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              "triangle-down",
              "diamond",
              "circle",
              "triangle-up",
              "square"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          },
          {
            "field": "range_text_unit",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "no-range",
      "transform": [
        {
          "filter": "datum.status == 'unknown'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "color": {
          "x-eas:slot": "unknown_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.6,
              1.6
            ],
            "nice": false,
            "zero": false
          },
          "datum": 0.5
        },
        "text": {
          "value": "no range"
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          }
        ]
      }
    }
  ]
}
