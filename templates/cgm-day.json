{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "cgm-day",
    "version": "1.0.0",
    "doc": "A continuous glucose monitor day: the glucose line over 24 hours against the target range from the data source (band: green, yellow near each limit); readings are red out of range (triangle-down low, triangle-up high, letter L or H), yellow near a limit, green in range, grey with no range. Optional very low / very high limits are drawn as labelled dashed rules; a reading beyond one is red like any out-of-range reading but larger and flagged with its letter and !! (dense days are not lettered otherwise).",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, glucose, warn_low?, warn_high?, warn_margin?}: an ISO date-time and the glucose in the slot unit, oldest first; the warn fields override the warning zone for that reading"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A continuous glucose monitor day: the glucose line over 24 hours against the target range from the data source (band: green, yellow near each limit); readings are red out of range (triangle-down low, triangle-up high, letter L or H), yellow near a limit, green in range, grey with no range. Optional very low / very high limits are drawn as labelled dashed rules; a reading beyond one is red like any out-of-range reading but larger and flagged with its letter and !! (dense days are not lettered otherwise).",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "very_low": {
        "type": "number",
        "default": null,
        "doc": "optional, from the data source or care team: drawn as a dashed rule labelled very low; a reading below it is flagged !! (still red)"
      },
      "low": {
        "type": "number",
        "default": null,
        "doc": "lower limit of the target range, from the data source or care team; required for coloring (null: no lower limit)"
      },
      "high": {
        "type": "number",
        "default": null,
        "doc": "upper limit of the target range, from the data source or care team; required for coloring (null: no upper limit; both null: readings are grey, no range)"
      },
      "very_high": {
        "type": "number",
        "default": null,
        "doc": "optional, from the data source or care team: drawn as a dashed rule labelled very high; a reading above it is flagged !! (still red)"
      },
      "unit": {
        "type": "string",
        "default": "mg/dL",
        "doc": "glucose unit label, shown in titles (a label, not a threshold)"
      },
      "band_label": {
        "type": "string",
        "default": "target range",
        "doc": "tooltip name of the target band"
      },
      "x_format": {
        "type": "string",
        "default": "%H:%M"
      },
      "x_ticks": {
        "type": "integer",
        "default": 8
      },
      "line_color": {
        "type": "string",
        "doc": "neutral line color (the theme's)"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside each limit, as a fraction of the target range width (of the one bound for a one-sided range)"
      },
      "warn_low": {
        "type": "number",
        "default": null,
        "doc": "optional: the value below which a reading is yellow, replacing low + margin"
      },
      "warn_high": {
        "type": "number",
        "default": null,
        "doc": "optional: the value above which a reading is yellow, replacing high - margin"
      },
      "decimals": {
        "type": "integer",
        "default": null,
        "doc": "exact decimals of every displayed number (a row's own decimals wins); without it a number shows sig_figs significant figures but never fewer decimals than its reference limits show. Display only: status is judged on the number as given"
      },
      "sig_figs": {
        "type": "integer",
        "doc": "significant figures of a displayed number when decimals is not set (the theme's :sig-figs, 3)"
      }
    },
    "example": "examples/cgm-day.data.json",
    "health": {
      "group": "glucose",
      "text_size": [
        100,
        26
      ],
      "svg_size": [
        1000,
        420
      ],
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "glucose": "range:10:800",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1",
            "decimals": "?range:0:8"
          },
          "order": "time",
          "rows": [
            {
              "le": [
                "warn_low",
                "warn_high"
              ],
              "code": "range_inverted"
            }
          ]
        }
      },
      "rules": [
        {
          "le": [
            "very_low",
            "low"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "low",
            "high"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "high",
            "very_high"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "low",
            "warn_low"
          ],
          "code": "warn_outside_range"
        },
        {
          "le": [
            "warn_high",
            "high"
          ],
          "code": "warn_outside_range"
        }
      ],
      "slots": {
        "warn_margin": "range:0:1",
        "decimals": "range:0:8",
        "sig_figs": "range:1:10"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 260,
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "health-status",
      "value": "glucose",
      "low": {
        "x-eas:slot": "low"
      },
      "high": {
        "x-eas:slot": "high"
      },
      "warn_low": {
        "x-eas:slot": "warn_low"
      },
      "warn_high": {
        "x-eas:slot": "warn_high"
      },
      "margin": {
        "x-eas:slot": "warn_margin"
      }
    },
    {
      "x-eas:transform": "health-format",
      "fields": [
        "glucose"
      ],
      "decimals": {
        "x-eas:slot": "decimals"
      },
      "sig": {
        "x-eas:slot": "sig_figs"
      },
      "low": {
        "x-eas:slot": "low"
      },
      "high": {
        "x-eas:slot": "high"
      }
    },
    {
      "calculate": "0",
      "as": "extreme"
    },
    {
      "x-eas:when": "very_low",
      "spec": {
        "calculate": {
          "x-eas:expr": "datum.glucose < {{very_low}} ? 1 : datum.extreme"
        },
        "as": "extreme"
      }
    },
    {
      "x-eas:when": "very_high",
      "spec": {
        "calculate": {
          "x-eas:expr": "datum.glucose > {{very_high}} ? 1 : datum.extreme"
        },
        "as": "extreme"
      }
    },
    {
      "calculate": "datum.extreme == 1 ? 150 : datum.status_label == 'low' || datum.status_label == 'high' ? 70 : 30",
      "as": "pt_size"
    },
    {
      "calculate": "datum.extreme == 1 ? datum.status_flag + '!!' : datum.status_flag",
      "as": "flag_text"
    }
  ],
  "layer": [
    {
      "name": "target",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "band_lo",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "band_hi",
              "as": "hi"
            },
            {
              "op": "max",
              "field": "zone_low",
              "as": "zl"
            },
            {
              "op": "max",
              "field": "zone_high",
              "as": "zh"
            }
          ]
        },
        {
          "filter": "isValid(datum.lo)"
        },
        {
          "calculate": "isValid(datum.zl) ? datum.zl : datum.lo",
          "as": "y0"
        },
        {
          "calculate": "isValid(datum.zh) ? datum.zh : datum.hi",
          "as": "y1"
        },
        {
          "filter": "true"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.22,
        "color": {
          "x-eas:slot": "ok_color"
        }
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "{{band_label}}"
            },
            "title": "range"
          }
        ]
      }
    },
    {
      "name": "target-warn-low",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "band_lo",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "band_hi",
              "as": "hi"
            },
            {
              "op": "max",
              "field": "zone_low",
              "as": "zl"
            },
            {
              "op": "max",
              "field": "zone_high",
              "as": "zh"
            }
          ]
        },
        {
          "filter": "isValid(datum.lo)"
        },
        {
          "calculate": "datum.lo",
          "as": "y0"
        },
        {
          "calculate": "datum.zl",
          "as": "y1"
        },
        {
          "filter": "isValid(datum.zl)"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.35,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "{{band_label}}"
            },
            "title": "range"
          }
        ]
      }
    },
    {
      "name": "target-warn-high",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "band_lo",
              "as": "lo"
            },
            {
              "op": "max",
              "field": "band_hi",
              "as": "hi"
            },
            {
              "op": "max",
              "field": "zone_low",
              "as": "zl"
            },
            {
              "op": "max",
              "field": "zone_high",
              "as": "zh"
            }
          ]
        },
        {
          "filter": "isValid(datum.lo)"
        },
        {
          "calculate": "datum.zh",
          "as": "y0"
        },
        {
          "calculate": "datum.hi",
          "as": "y1"
        },
        {
          "filter": "isValid(datum.zh)"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.35,
        "color": {
          "x-eas:slot": "warn_color"
        }
      },
      "encoding": {
        "y": {
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "field": "y0"
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "{{band_label}}"
            },
            "title": "range"
          }
        ]
      }
    },
    {
      "x-eas:when": "very_low",
      "spec": {
        "name": "very-low-line",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeDash": [
            4,
            3
          ],
          "color": {
            "x-eas:slot": "secondary"
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:slot": "very_low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          }
        }
      }
    },
    {
      "x-eas:when": "very_low",
      "spec": {
        "name": "very-low-label",
        "transform": [
          {
            "aggregate": [
              {
                "op": "min",
                "field": "time",
                "as": "t0"
              }
            ]
          },
          {
            "calculate": {
              "x-eas:expr": "'very low ' + {{very_low}}"
            },
            "as": "txt"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "bottom",
          "dx": 4,
          "dy": -2,
          "fontSize": 11,
          "color": {
            "x-eas:slot": "secondary"
          }
        },
        "encoding": {
          "x": {
            "field": "t0",
            "type": "temporal"
          },
          "y": {
            "datum": {
              "x-eas:slot": "very_low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "text": {
            "field": "txt"
          }
        }
      }
    },
    {
      "x-eas:when": "very_high",
      "spec": {
        "name": "very-high-line",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeDash": [
            4,
            3
          ],
          "color": {
            "x-eas:slot": "secondary"
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:slot": "very_high"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          }
        }
      }
    },
    {
      "x-eas:when": "very_high",
      "spec": {
        "name": "very-high-label",
        "transform": [
          {
            "aggregate": [
              {
                "op": "min",
                "field": "time",
                "as": "t0"
              }
            ]
          },
          {
            "calculate": {
              "x-eas:expr": "'very high ' + {{very_high}}"
            },
            "as": "txt"
          }
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "bottom",
          "dx": 4,
          "dy": -2,
          "fontSize": 11,
          "color": {
            "x-eas:slot": "secondary"
          }
        },
        "encoding": {
          "x": {
            "field": "t0",
            "type": "temporal"
          },
          "y": {
            "datum": {
              "x-eas:slot": "very_high"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "text": {
            "field": "txt"
          }
        }
      }
    },
    {
      "name": "glucose",
      "mark": {
        "type": "line",
        "strokeWidth": 1.5,
        "color": {
          "x-eas:slot": "muted"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "glucose",
          "type": "quantitative",
          "title": {
            "x-eas:text": "Glucose ({{unit}})"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        }
      }
    },
    {
      "name": "readings",
      "mark": {
        "type": "point",
        "filled": true,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "glucose",
          "type": "quantitative",
          "title": {
            "x-eas:text": "Glucose ({{unit}})"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              "triangle-down",
              "diamond",
              "circle",
              "triangle-up",
              "square"
            ]
          },
          "legend": null
        },
        "size": {
          "field": "pt_size",
          "type": "quantitative",
          "scale": null,
          "legend": null
        },
        "tooltip": [
          {
            "field": "time",
            "type": "temporal",
            "format": "%H:%M"
          },
          {
            "field": "glucose_text",
            "title": "glucose"
          },
          {
            "field": "status_label",
            "title": "status"
          },
          {
            "field": "range_text",
            "title": "target"
          }
        ]
      }
    },
    {
      "name": "flags",
      "transform": [
        {
          "filter": "datum.extreme == 1"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "bottom",
        "dy": -9,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "bad_color"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "glucose",
          "type": "quantitative",
          "title": {
            "x-eas:text": "Glucose ({{unit}})"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "text": {
          "field": "flag_text"
        }
      }
    }
  ]
}
