{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "cgm-day",
    "version": "1.0.0",
    "doc": "A continuous glucose monitor day: the glucose line over 24 hours, the target range as a band, very low and very high limits as dashed rules, readings outside the range flagged by colour and shape.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, glucose}: an ISO date-time and the glucose in the slot unit, oldest first"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A continuous glucose monitor day: the glucose line over 24 hours, the target range as a band, very low and very high limits as dashed rules, readings outside the range flagged by colour and shape.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "very_low": {
        "type": "number",
        "default": 54,
        "doc": "below this: very low (consensus level 2 hypoglycemia, mg/dL)"
      },
      "low": {
        "type": "number",
        "default": 70,
        "doc": "below this: low; the bottom of the target range (mg/dL)"
      },
      "high": {
        "type": "number",
        "default": 180,
        "doc": "above this: high; the top of the target range (mg/dL)"
      },
      "very_high": {
        "type": "number",
        "default": 250,
        "doc": "above this: very high (mg/dL)"
      },
      "unit": {
        "type": "string",
        "default": "mg/dL",
        "doc": "glucose unit, shown in titles"
      },
      "x_format": {
        "type": "string",
        "default": "%H:%M"
      },
      "x_ticks": {
        "type": "integer",
        "default": 8
      },
      "band_color": {
        "type": "string",
        "default": "#2a9d8f",
        "doc": "target range band"
      }
    },
    "example": "examples/cgm-day.data.json",
    "health": {
      "group": "glucose",
      "text_size": [
        100,
        26
      ],
      "svg_size": [
        1000,
        420
      ],
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "glucose": "range:10:800"
          },
          "order": "time"
        }
      },
      "rules": [
        {
          "le": [
            "very_low",
            "low"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "low",
            "high"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "high",
            "very_high"
          ],
          "code": "range_inverted"
        }
      ]
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 260,
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "calculate": {
        "x-eas:expr": "datum.glucose < {{very_low}} ? '\u25c6 very low' : datum.glucose < {{low}} ? '\u25bc low' : datum.glucose > {{very_high}} ? '\u25a0 very high' : datum.glucose > {{high}} ? '\u25b2 high' : '\u25cf in range'"
      },
      "as": "zone"
    }
  ],
  "layer": [
    {
      "name": "target",
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ]
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.2,
        "color": {
          "x-eas:slot": "band_color"
        }
      },
      "encoding": {
        "y": {
          "datum": {
            "x-eas:slot": "low"
          },
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "y2": {
          "datum": {
            "x-eas:slot": "high"
          }
        },
        "tooltip": [
          {
            "value": {
              "x-eas:text": "target range {{low}}-{{high}} {{unit}}"
            },
            "title": "range"
          }
        ]
      }
    },
    {
      "name": "very-low-line",
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#8b1e1e"
      },
      "encoding": {
        "y": {
          "datum": {
            "x-eas:slot": "very_low"
          },
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          }
        }
      }
    },
    {
      "name": "very-high-line",
      "transform": [
        {
          "aggregate": [
            {
              "op": "count",
              "as": "n"
            }
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          3
        ],
        "color": "#b35c00"
      },
      "encoding": {
        "y": {
          "datum": {
            "x-eas:slot": "very_high"
          },
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          }
        }
      }
    },
    {
      "name": "glucose",
      "mark": {
        "type": "line",
        "strokeWidth": 1.5,
        "color": {
          "x-eas:slot": "muted"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "glucose",
          "type": "quantitative",
          "title": {
            "x-eas:text": "Glucose ({{unit}})"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        }
      }
    },
    {
      "name": "flagged",
      "transform": [
        {
          "filter": "datum.zone != '\u25cf in range'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 60,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "glucose",
          "type": "quantitative",
          "title": {
            "x-eas:text": "Glucose ({{unit}})"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "color": {
          "field": "zone",
          "type": "nominal",
          "scale": {
            "domain": [
              "\u25c6 very low",
              "\u25bc low",
              "\u25cf in range",
              "\u25b2 high",
              "\u25a0 very high"
            ],
            "range": [
              "#8b1e1e",
              "#d03b3b",
              "#2a78d6",
              "#e09a00",
              "#b35c00"
            ]
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "zone",
          "type": "nominal",
          "scale": {
            "domain": [
              "\u25c6 very low",
              "\u25bc low",
              "\u25cf in range",
              "\u25b2 high",
              "\u25a0 very high"
            ],
            "range": [
              "diamond",
              "triangle-down",
              "circle",
              "triangle-up",
              "square"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "time",
            "type": "temporal",
            "format": "%H:%M"
          },
          {
            "field": "glucose",
            "title": "glucose"
          },
          {
            "field": "zone",
            "title": "zone"
          }
        ]
      }
    }
  ]
}
