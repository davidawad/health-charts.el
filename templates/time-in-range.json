{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "time-in-range",
    "version": "1.0.0",
    "doc": "Time in range: the share of glucose readings very low, low, in range, high and very high per period (weeks, days, any label you give), computed from the raw readings against the four cut-offs from the data source (all required). Out-of-range shares are red (very low and very high solid, low and high tinted), in range is green. Shares have no warning margin, so there is no yellow. An optional target_pct draws a target tick on the in-range share.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, glucose, period?}: readings with an optional period label; without one all readings count together"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Time in range: the share of glucose readings very low, low, in range, high and very high per period (weeks, days, any label you give), computed from the raw readings against the four cut-offs from the data source (all required). Out-of-range shares are red (very low and very high solid, low and high tinted), in range is green. Shares have no warning margin, so there is no yellow. An optional target_pct draws a target tick on the in-range share.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "very_low": {
        "type": "number",
        "required": true,
        "doc": "below this: very low; from the data source or care team (no built-in default)"
      },
      "low": {
        "type": "number",
        "required": true,
        "doc": "below this: low; the bottom of the in-range band; from the data source or care team (no built-in default)"
      },
      "high": {
        "type": "number",
        "required": true,
        "doc": "above this: high; the top of the in-range band; from the data source or care team (no built-in default)"
      },
      "very_high": {
        "type": "number",
        "required": true,
        "doc": "above this: very high; from the data source or care team (no built-in default)"
      },
      "target_pct": {
        "type": "number",
        "default": null,
        "doc": "optional goal for the in-range share, in percent, from the data source or care team; when given a tick marks it on the in-range segment of each period (null: nothing is drawn)"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range: very low and very high solid, low and high tinted (the theme's red)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      }
    },
    "example": "examples/time-in-range.data.json",
    "health": {
      "group": "glucose",
      "text_size": [
        100,
        16
      ],
      "svg_size": [
        1000,
        300
      ],
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "glucose": "range:10:800",
            "period": "?string"
          },
          "order": "time"
        }
      },
      "rules": [
        {
          "le": [
            "very_low",
            "low"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "low",
            "high"
          ],
          "code": "range_inverted"
        },
        {
          "le": [
            "high",
            "very_high"
          ],
          "code": "range_inverted"
        }
      ],
      "slots": {
        "target_pct": "range:0:100"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 44
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "calculate": {
        "x-eas:expr": "datum.glucose < {{very_low}} ? 0 : datum.glucose < {{low}} ? 1 : datum.glucose > {{very_high}} ? 4 : datum.glucose > {{high}} ? 3 : 2"
      },
      "as": "ord"
    },
    {
      "calculate": "isValid(datum.period) ? datum.period : 'All readings'",
      "as": "per"
    },
    {
      "calculate": "datum.ord == 0 ? 'very low' : datum.ord == 1 ? 'low' : datum.ord == 2 ? 'in range' : datum.ord == 3 ? 'high' : 'very high'",
      "as": "zone"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        }
      ],
      "groupby": [
        "per",
        "zone",
        "ord"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "total"
        }
      ],
      "groupby": [
        "per"
      ]
    },
    {
      "stack": "count",
      "groupby": [
        "per"
      ],
      "as": [
        "s0",
        "s1"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "ord",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "(datum.s0 + datum.s1) / 2",
      "as": "mid"
    },
    {
      "calculate": "datum.ord == 1 || datum.ord == 3 ? 0.5 : 1",
      "as": "tint"
    },
    {
      "calculate": "format(100 * datum.count / datum.total, '.0f') + '%'",
      "as": "pct"
    },
    {
      "calculate": "datum.pct + ' ' + datum.zone + ' (' + datum.count + ' of ' + datum.total + ' readings)'",
      "as": "detail"
    }
  ],
  "encoding": {
    "y": {
      "field": "per",
      "type": "nominal",
      "title": null,
      "sort": null,
      "axis": {
        "domain": false,
        "ticks": false
      }
    }
  },
  "layer": [
    {
      "name": "shares",
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.72
        },
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "s0",
          "type": "quantitative",
          "title": "share of readings",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "format": ".0%"
          }
        },
        "x2": {
          "field": "s1"
        },
        "color": {
          "field": "zone",
          "type": "nominal",
          "scale": {
            "domain": [
              "very low",
              "low",
              "in range",
              "high",
              "very high"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "bad_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "per",
            "title": "period"
          },
          {
            "field": "detail",
            "title": "readings"
          }
        ],
        "opacity": {
          "field": "tint",
          "type": "quantitative",
          "scale": null,
          "legend": null
        }
      }
    },
    {
      "name": "labels",
      "transform": [
        {
          "filter": "datum.s1 - datum.s0 >= 0.06"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "surface"
        }
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "pct"
        }
      }
    },
    {
      "x-eas:when": "target_pct",
      "spec": {
        "name": "target",
        "transform": [
          {
            "filter": "datum.ord == 2"
          },
          {
            "calculate": {
              "x-eas:expr": "datum.s0 + {{target_pct}} / 100"
            },
            "as": "tx"
          },
          {
            "filter": "datum.tx <= 1"
          }
        ],
        "mark": {
          "type": "tick",
          "orient": "vertical",
          "thickness": 2,
          "height": {
            "band": 0.9
          },
          "color": {
            "x-eas:slot": "ink"
          }
        },
        "encoding": {
          "x": {
            "field": "tx",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "value": {
                "x-eas:text": "target {{target_pct}}% in range (tick: where the in-range share would meet it)"
              },
              "title": "target"
            }
          ]
        }
      }
    }
  ]
}
