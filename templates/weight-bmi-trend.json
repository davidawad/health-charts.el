{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "weight-bmi-trend",
    "version": "1.0.0",
    "doc": "BMI over time, computed from weight and height, against the WHO adult categories (under 18.5, 18.5-24.9, 25-29.9, 30 and over); the weight is in the tooltip.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, weight_kg}: an ISO date and the weight in kilograms, oldest first"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "BMI over time, computed from weight and height, against the WHO adult categories (under 18.5, 18.5-24.9, 25-29.9, 30 and over); the weight is in the tooltip.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "bands": {
        "type": "array",
        "default": [
          {
            "label": "underweight",
            "low": 14,
            "high": 18.5,
            "color": "#2a78d6"
          },
          {
            "label": "normal",
            "low": 18.5,
            "high": 25,
            "color": "#2a9d8f"
          },
          {
            "label": "overweight",
            "low": 25,
            "high": 30,
            "color": "#e09a00"
          },
          {
            "label": "obesity",
            "low": 30,
            "high": 36,
            "color": "#d03b3b"
          }
        ],
        "doc": "category bands [{label, low, high, color}], drawn bottom to top"
      },
      "target": {
        "type": "number",
        "default": null,
        "doc": "optional personal target: a dashed line"
      },
      "y_title": {
        "type": "string",
        "default": "BMI (kg/m\u00b2)",
        "doc": "y-axis title"
      },
      "line_color": {
        "type": "string",
        "default": "#2a78d6"
      },
      "x_format": {
        "type": "string",
        "default": "%b %d",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "height_m": {
        "type": "number",
        "doc": "height in metres",
        "required": true
      }
    },
    "example": "examples/weight-bmi-trend.data.json",
    "health": {
      "group": "metabolic",
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "weight_kg": "range:20:400"
          },
          "order": "time"
        },
        "bands": {
          "optional": true,
          "fields": {
            "label": "string",
            "low": "number",
            "high": "number",
            "color": "?string"
          },
          "rows": [
            {
              "le": [
                "low",
                "high"
              ],
              "code": "range_inverted"
            }
          ]
        }
      },
      "text_size": [
        100,
        26
      ],
      "svg_size": [
        1000,
        420
      ]
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 260,
  "data": {
    "name": "data"
  },
  "layer": [
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "band",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rect",
          "opacity": 0.22,
          "color": {
            "x-eas:item": "color"
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "y2": {
            "datum": {
              "x-eas:item": "high"
            }
          },
          "tooltip": [
            {
              "value": {
                "x-eas:text": "{{@label}}"
              },
              "title": "band"
            }
          ]
        }
      }
    },
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "edge",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeWidth": 1,
          "color": {
            "x-eas:item": "color"
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          }
        }
      }
    },
    {
      "x-eas:each": "bands",
      "spec": {
        "name": "band-label",
        "transform": [
          {
            "aggregate": [
              {
                "op": "max",
                "field": "time",
                "as": "t_end"
              }
            ]
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "bottom",
          "dx": -4,
          "dy": -2,
          "fontSize": 11,
          "color": {
            "x-eas:slot": "secondary"
          }
        },
        "encoding": {
          "x": {
            "field": "t_end",
            "type": "temporal"
          },
          "y": {
            "datum": {
              "x-eas:item": "low"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "text": {
            "value": {
              "x-eas:item": "label"
            }
          }
        }
      }
    },
    {
      "x-eas:when": "target",
      "spec": {
        "name": "target",
        "transform": [
          {
            "aggregate": [
              {
                "op": "count",
                "as": "n"
              }
            ]
          }
        ],
        "mark": {
          "type": "rule",
          "strokeDash": [
            6,
            4
          ],
          "strokeWidth": 1.5,
          "color": {
            "x-eas:slot": "ink"
          }
        },
        "encoding": {
          "y": {
            "datum": {
              "x-eas:slot": "target"
            },
            "type": "quantitative",
            "scale": {
              "zero": false,
              "nice": true
            }
          },
          "tooltip": [
            {
              "value": "personal target",
              "title": "line"
            }
          ]
        }
      }
    },
    {
      "name": "series",
      "mark": {
        "type": "line",
        "strokeWidth": 2,
        "color": {
          "x-eas:slot": "muted"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        }
      }
    },
    {
      "name": "readings",
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5,
        "color": {
          "x-eas:slot": "line_color"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "tooltip": [
          {
            "field": "time",
            "type": "temporal",
            "format": "%Y-%m-%d"
          },
          {
            "field": "value",
            "title": "BMI",
            "format": ".1f"
          },
          {
            "field": "weight_kg",
            "title": "weight (kg)"
          }
        ]
      }
    },
    {
      "name": "latest",
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "rn"
            }
          ],
          "sort": [
            {
              "field": "time",
              "order": "descending"
            }
          ]
        },
        {
          "filter": "datum.rn == 1"
        },
        {
          "calculate": "'latest ' + format(datum.value, '.1f')",
          "as": "latest_text"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "baseline": "bottom",
        "dx": -4,
        "dy": -12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "ink"
        }
      },
      "encoding": {
        "x": {
          "field": "time",
          "type": "temporal",
          "title": null,
          "axis": {
            "grid": false,
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            }
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "y_title"
          },
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "text": {
          "field": "latest_text"
        }
      }
    }
  ],
  "transform": [
    {
      "calculate": {
        "x-eas:expr": "datum.weight_kg / ({{height_m}} * {{height_m}})"
      },
      "as": "value"
    }
  ]
}
