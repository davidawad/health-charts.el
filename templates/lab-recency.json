{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "lab-recency",
    "version": "1.0.0",
    "doc": "How long ago each test was last drawn, against how often it is due: a bar of days since the last draw and a tick at the interval. Staleness is not a health status, so it is drawn in blues only: lighter within the interval, deeper when overdue (up to overdue_factor times the interval), darkest when long overdue, grey when never drawn; each state is also written next to its bar. The reference date as_of is supplied, never read from a clock.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {test, last_drawn? (ISO date, omit if never), interval_days}: one row per test; interval_days is how often the test is due and comes from the data source"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "How long ago each test was last drawn, against how often it is due: a bar of days since the last draw and a tick at the interval. Staleness is not a health status, so it is drawn in blues only: lighter within the interval, deeper when overdue (up to overdue_factor times the interval), darkest when long overdue, grey when never drawn; each state is also written next to its bar. The reference date as_of is supplied, never read from a clock.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "unknown_color": {
        "type": "string",
        "doc": "never drawn (the theme's grey)"
      },
      "as_of": {
        "type": "string",
        "doc": "reference date, ISO YYYY-MM-DD: days are counted up to it",
        "required": true
      },
      "overdue_factor": {
        "type": "number",
        "default": 1.5,
        "doc": "a test is overdue up to this many times its interval and long overdue beyond it; a presentation default, not a clinical threshold"
      },
      "within_color": {
        "type": "string",
        "default": "#9ec5f0",
        "doc": "within the interval (light blue)"
      },
      "overdue_color": {
        "type": "string",
        "default": "#2a78d6",
        "doc": "overdue, up to overdue_factor times the interval (deeper blue)"
      },
      "long_overdue_color": {
        "type": "string",
        "default": "#123f7a",
        "doc": "long overdue, beyond overdue_factor times the interval (darkest blue)"
      }
    },
    "example": "examples/lab-recency.data.json",
    "health": {
      "group": "labs",
      "tables": {
        "data": {
          "fields": {
            "test": "string",
            "last_drawn": "?date",
            "interval_days": "int"
          }
        }
      },
      "text_size": [
        100,
        20
      ],
      "svg_size": [
        1000,
        360
      ],
      "slots": {
        "as_of": "date",
        "overdue_factor": "range:1:1000"
      }
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 30
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "calculate": {
        "x-eas:expr": "isValid(datum.last_drawn) ? round((toDate({{as_of}}) - toDate(datum.last_drawn)) / 86400000) : 0"
      },
      "as": "days"
    },
    {
      "calculate": {
        "x-eas:expr": "!isValid(datum.last_drawn) ? '? never drawn' : datum.days <= datum.interval_days ? '\u25cb within interval' : datum.days <= datum.interval_days * {{overdue_factor}} ? '\u25d0 overdue' : '\u25cf long overdue'"
      },
      "as": "state"
    },
    {
      "calculate": "isValid(datum.last_drawn) ? datum.days / datum.interval_days : 99",
      "as": "ratio"
    },
    {
      "calculate": "datum.test + '  (every ' + datum.interval_days + ' d)' + (isValid(datum.last_drawn) ? '  ' + datum.days + ' d ago' : '')",
      "as": "row_label"
    },
    {
      "calculate": "datum.state",
      "as": "state_text"
    },
    {
      "calculate": "max(datum.days, datum.interval_days)",
      "as": "word_x"
    }
  ],
  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "ratio",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 380
      }
    }
  },
  "layer": [
    {
      "name": "days",
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.55
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "tickCount": 6
          },
          "field": "days",
          "title": "days since last draw"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "\u25cb within interval",
              "\u25d0 overdue",
              "\u25cf long overdue",
              "? never drawn"
            ],
            "range": [
              {
                "x-eas:slot": "within_color"
              },
              {
                "x-eas:slot": "overdue_color"
              },
              {
                "x-eas:slot": "long_overdue_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "test"
          },
          {
            "field": "last_drawn"
          },
          {
            "field": "days",
            "title": "days ago"
          },
          {
            "field": "interval_days",
            "title": "every (days)"
          },
          {
            "field": "state"
          }
        ]
      }
    },
    {
      "name": "interval",
      "mark": {
        "type": "tick",
        "thickness": 3,
        "color": {
          "x-eas:slot": "ink"
        },
        "orient": "vertical",
        "size": 24
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "axis": {
            "tickCount": 6
          },
          "field": "interval_days"
        },
        "tooltip": [
          {
            "field": "test"
          },
          {
            "field": "interval_days",
            "title": "should be drawn every (days)"
          }
        ]
      }
    },
    {
      "name": "state-word",
      "transform": [
        {
          "filter": "isValid(datum.last_drawn)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "color": {
          "x-eas:slot": "secondary"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "field": "word_x"
        },
        "text": {
          "field": "state_text"
        }
      }
    },
    {
      "name": "never",
      "transform": [
        {
          "filter": "!isValid(datum.last_drawn)"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 11,
        "color": {
          "x-eas:slot": "secondary"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "zero": true,
            "nice": true
          },
          "datum": 0
        },
        "text": {
          "field": "state_text"
        },
        "tooltip": [
          {
            "field": "test"
          },
          {
            "field": "interval_days",
            "title": "every (days)"
          }
        ]
      }
    }
  ]
}
