{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "health-dual",
    "version": "1.0.0",
    "doc": "Two related markers over time, one on a left and one on a right axis, each with its target limit.",
    "slots": {
      "data": {
        "shape": "biomarker",
        "required": true,
        "doc": "health-chart measurements (the biomarker adapter)"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Two related markers over time, one on a left and one on a right axis, each with its target limit.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "ref_color": {
        "type": "string",
        "default": "#b8b7ad",
        "doc": "reference band"
      },
      "opt_color": {
        "type": "string",
        "default": "#0ca30c",
        "doc": "optimal band"
      },
      "status_domain": {
        "type": "array",
        "items": "string",
        "default": [
          "\u25cf optimal",
          "\u25cb normal",
          "\u25d0 suboptimal",
          "\u25bc low",
          "\u25b2 high",
          "? n/a"
        ],
        "doc": "status legend entries, glyph and word (never color alone)"
      },
      "status_range": {
        "type": "array",
        "items": "string",
        "default": [
          "#0ca30c",
          "#2a78d6",
          "#e09a00",
          "#d03b3b",
          "#d03b3b",
          "#898781"
        ]
      },
      "status_shape": {
        "type": "array",
        "items": "string",
        "default": [
          "circle",
          "square",
          "diamond",
          "triangle-down",
          "triangle-up",
          "cross"
        ]
      },
      "x_format": {
        "type": "string",
        "default": "%Y",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "ref": {
        "type": "boolean",
        "default": true,
        "doc": "show the reference band"
      },
      "optimal": {
        "type": "boolean",
        "default": true,
        "doc": "show the optimal band"
      },
      "left_color": {
        "type": "string",
        "default": "#2a78d6"
      },
      "right_color": {
        "type": "string",
        "default": "#4a3aa7"
      },
      "left_title": {
        "type": "string",
        "default": ""
      },
      "right_title": {
        "type": "string",
        "default": ""
      },
      "left_domain": {
        "type": "array",
        "default": [
          0,
          1
        ],
        "doc": "left value axis [lo, hi]"
      },
      "right_domain": {
        "type": "array",
        "default": [
          0,
          1
        ],
        "doc": "right value axis [lo, hi]"
      }
    },
    "example": "../examples/eas/health-dual.data.json"
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 240,
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "status"
    },
    {
      "x-eas:transform": "reference-band",
      "scale": "value",
      "ref": {
        "x-eas:slot": "ref"
      },
      "optimal": {
        "x-eas:slot": "optimal"
      },
      "limit": true
    }
  ],
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "layer": [
    {
      "name": "frame",
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "x_lo",
              "as": "x0"
            },
            {
              "op": "max",
              "field": "x_hi",
              "as": "x1"
            }
          ]
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "temporal"
        },
        "x2": {
          "field": "x1"
        }
      }
    },
    {
      "name": "left-line",
      "transform": [
        {
          "filter": "datum.axis == 'left'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": {
          "x-eas:slot": "left_color"
        }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            },
            "grid": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "left_title"
          },
          "scale": {
            "zero": false,
            "nice": false,
            "domain": {
              "x-eas:slot": "left_domain"
            }
          },
          "axis": {
            "orient": "left",
            "titleColor": {
              "x-eas:slot": "left_color"
            }
          }
        }
      }
    },
    {
      "name": "left-limit",
      "transform": [
        {
          "filter": "datum.axis == 'left'"
        },
        {
          "filter": "isValid(datum.limit)"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeWidth": 1.5,
            "strokeDash": [
              2,
              4
            ],
            "color": {
              "x-eas:slot": "left_color"
            },
            "opacity": 0.8
          },
          "encoding": {
            "y": {
              "field": "limit",
              "type": "quantitative",
              "scale": {
                "zero": false,
                "nice": false,
                "domain": {
                  "x-eas:slot": "left_domain"
                }
              },
              "axis": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "dx": 6,
            "dy": -3,
            "fontSize": 11,
            "color": {
              "x-eas:slot": "left_color"
            }
          },
          "encoding": {
            "y": {
              "field": "limit",
              "type": "quantitative",
              "scale": {
                "zero": false,
                "nice": false,
                "domain": {
                  "x-eas:slot": "left_domain"
                }
              },
              "axis": null
            },
            "text": {
              "field": "limit_label"
            }
          }
        }
      ]
    },
    {
      "name": "left-draws",
      "transform": [
        {
          "filter": "datum.axis == 'left'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            },
            "grid": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": false,
            "domain": {
              "x-eas:slot": "left_domain"
            }
          },
          "axis": null
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_range"
            }
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_shape"
            }
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "date",
            "type": "temporal",
            "format": "%Y-%m-%d"
          },
          {
            "field": "value_label",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          }
        ]
      }
    },
    {
      "name": "right-line",
      "transform": [
        {
          "filter": "datum.axis == 'right'"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": {
          "x-eas:slot": "right_color"
        },
        "strokeDash": [
          7,
          4
        ]
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            },
            "grid": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "title": {
            "x-eas:slot": "right_title"
          },
          "scale": {
            "zero": false,
            "nice": false,
            "domain": {
              "x-eas:slot": "right_domain"
            }
          },
          "axis": {
            "orient": "right",
            "titleColor": {
              "x-eas:slot": "right_color"
            }
          }
        }
      }
    },
    {
      "name": "right-limit",
      "transform": [
        {
          "filter": "datum.axis == 'right'"
        },
        {
          "filter": "isValid(datum.limit)"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "rule",
            "strokeWidth": 1.5,
            "strokeDash": [
              2,
              4
            ],
            "color": {
              "x-eas:slot": "right_color"
            },
            "opacity": 0.8
          },
          "encoding": {
            "y": {
              "field": "limit",
              "type": "quantitative",
              "scale": {
                "zero": false,
                "nice": false,
                "domain": {
                  "x-eas:slot": "right_domain"
                }
              },
              "axis": null
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "bottom",
            "dx": 6,
            "dy": -3,
            "fontSize": 11,
            "color": {
              "x-eas:slot": "right_color"
            }
          },
          "encoding": {
            "y": {
              "field": "limit",
              "type": "quantitative",
              "scale": {
                "zero": false,
                "nice": false,
                "domain": {
                  "x-eas:slot": "right_domain"
                }
              },
              "axis": null
            },
            "text": {
              "field": "limit_label"
            }
          }
        }
      ]
    },
    {
      "name": "right-draws",
      "transform": [
        {
          "filter": "datum.axis == 'right'"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 120,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {
            "format": {
              "x-eas:slot": "x_format"
            },
            "tickCount": {
              "x-eas:slot": "x_ticks"
            },
            "grid": false
          }
        },
        "y": {
          "field": "value",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": false,
            "domain": {
              "x-eas:slot": "right_domain"
            }
          },
          "axis": null
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_range"
            }
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_shape"
            }
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "date",
            "type": "temporal",
            "format": "%Y-%m-%d"
          },
          {
            "field": "value_label",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          }
        ]
      }
    }
  ]
}
