{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "health-staleness",
    "version": "1.0.0",
    "doc": "Days since each indicator's draw, against the due and stale thresholds.",
    "slots": {
      "data": {
        "shape": "indicator-values",
        "required": true,
        "doc": "health-chart indicator values (the indicator-values adapter)"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Days since each indicator's draw, against the due and stale thresholds.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "ref_color": {
        "type": "string",
        "default": "#b8b7ad",
        "doc": "reference band"
      },
      "opt_color": {
        "type": "string",
        "default": "#0ca30c",
        "doc": "optimal band"
      },
      "status_domain": {
        "type": "array",
        "items": "string",
        "default": [
          "\u25cf optimal",
          "\u25cb normal",
          "\u25d0 suboptimal",
          "\u25bc low",
          "\u25b2 high",
          "? n/a"
        ],
        "doc": "status legend entries, glyph and word (never color alone)"
      },
      "status_range": {
        "type": "array",
        "items": "string",
        "default": [
          "#0ca30c",
          "#2a78d6",
          "#e09a00",
          "#d03b3b",
          "#d03b3b",
          "#898781"
        ]
      },
      "status_shape": {
        "type": "array",
        "items": "string",
        "default": [
          "circle",
          "square",
          "diamond",
          "triangle-down",
          "triangle-up",
          "cross"
        ]
      },
      "x_format": {
        "type": "string",
        "default": "%Y",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "state_domain": {
        "type": "array",
        "items": "string",
        "default": [
          "\u25cf fresh",
          "\u25d0 due",
          "\u25b2 stale",
          "? undated"
        ]
      },
      "state_range": {
        "type": "array",
        "items": "string",
        "default": [
          "#0ca30c",
          "#e09a00",
          "#d03b3b",
          "#898781"
        ]
      },
      "as_of": {
        "type": "string",
        "default": "",
        "doc": "date the draws are judged at (empty: the data's latest as_of, else today)"
      },
      "due_days": {
        "type": "integer",
        "default": 0,
        "doc": "days after which a draw is due (0: `health-chart-indicator-due-days')"
      },
      "stale_days": {
        "type": "integer",
        "default": 0,
        "doc": "days after which a draw is stale (0: `health-chart-indicator-stale-days')"
      },
      "due_color": {
        "type": "string",
        "default": "#e09a00"
      },
      "stale_color": {
        "type": "string",
        "default": "#d03b3b"
      }
    },
    "example": "../examples/eas/health-staleness.data.json"
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 28
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "staleness",
      "as_of": {
        "x-eas:slot": "as_of"
      },
      "due_days": {
        "x-eas:slot": "due_days"
      },
      "stale_days": {
        "x-eas:slot": "stale_days"
      }
    },
    {
      "calculate": "datum.label + '  ' + datum.days_label + ' \u00b7 ' + datum.state_label",
      "as": "row_label"
    }
  ],
  "layer": [
    {
      "name": "span",
      "mark": {
        "type": "rule",
        "opacity": 0
      },
      "encoding": {
        "x": {
          "field": "scale",
          "type": "quantitative"
        }
      }
    },
    {
      "name": "due",
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "due",
              "as": "at"
            }
          ],
          "groupby": [
            "due"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1.5,
        "strokeDash": [
          5,
          4
        ],
        "color": {
          "x-eas:slot": "due_color"
        }
      },
      "encoding": {
        "x": {
          "field": "at",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "at",
            "title": "due after (days)"
          }
        ]
      }
    },
    {
      "name": "stale",
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "stale",
              "as": "at"
            }
          ],
          "groupby": [
            "stale"
          ]
        }
      ],
      "mark": {
        "type": "rule",
        "strokeWidth": 1.5,
        "strokeDash": [
          5,
          4
        ],
        "color": {
          "x-eas:slot": "stale_color"
        }
      },
      "encoding": {
        "x": {
          "field": "at",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "at",
            "title": "stale after (days)"
          }
        ]
      }
    },
    {
      "name": "days",
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "y": {
          "field": "row_label",
          "type": "nominal",
          "sort": null,
          "title": null,
          "axis": {
            "domain": false,
            "ticks": false,
            "labelLimit": 300
          }
        },
        "x": {
          "field": "bar",
          "type": "quantitative",
          "title": "days since draw",
          "scale": {
            "zero": true,
            "nice": false
          }
        },
        "color": {
          "field": "state_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "state_domain"
            },
            "range": {
              "x-eas:slot": "state_range"
            }
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "indicator"
          },
          {
            "field": "date",
            "title": "drawn"
          },
          {
            "field": "days_label",
            "title": "since"
          },
          {
            "field": "state_label",
            "title": "state"
          }
        ]
      }
    }
  ]
}
