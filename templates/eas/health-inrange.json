{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "health-inrange",
    "version": "1.0.0",
    "doc": "The share of each marker's draws below, inside and above its reference range, worst first.",
    "slots": {
      "data": {
        "shape": "biomarker",
        "required": true,
        "doc": "health-chart measurements (the biomarker adapter)"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "The share of each marker's draws below, inside and above its reference range, worst first.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "ref_color": {
        "type": "string",
        "default": "#b8b7ad",
        "doc": "reference band"
      },
      "opt_color": {
        "type": "string",
        "default": "#0ca30c",
        "doc": "optimal band"
      },
      "status_domain": {
        "type": "array",
        "items": "string",
        "default": [
          "\u25cf optimal",
          "\u25cb normal",
          "\u25d0 suboptimal",
          "\u25bc low",
          "\u25b2 high",
          "? n/a"
        ],
        "doc": "status legend entries, glyph and word (never color alone)"
      },
      "status_range": {
        "type": "array",
        "items": "string",
        "default": [
          "#0ca30c",
          "#2a78d6",
          "#e09a00",
          "#d03b3b",
          "#d03b3b",
          "#898781"
        ]
      },
      "status_shape": {
        "type": "array",
        "items": "string",
        "default": [
          "circle",
          "square",
          "diamond",
          "triangle-down",
          "triangle-up",
          "cross"
        ]
      },
      "x_format": {
        "type": "string",
        "default": "%Y",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      }
    },
    "example": "../examples/eas/health-inrange.data.json"
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 28
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "status"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "count"
        }
      ],
      "groupby": [
        "marker",
        "label",
        "status",
        "status_label",
        "glyph"
      ]
    },
    {
      "calculate": "datum.status == 'low' ? 0 : datum.status == 'optimal' ? 1 : datum.status == 'normal' ? 2 : datum.status == 'suboptimal' ? 3 : datum.status == 'high' ? 4 : 5",
      "as": "ord"
    },
    {
      "calculate": "datum.ord >= 1 && datum.ord <= 3 ? datum.count : 0",
      "as": "inside_n"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "count",
          "as": "draws"
        },
        {
          "op": "sum",
          "field": "inside_n",
          "as": "inside"
        }
      ],
      "groupby": [
        "marker"
      ]
    },
    {
      "calculate": "datum.inside / datum.draws",
      "as": "share_in"
    },
    {
      "calculate": "datum.label + '  ' + datum.inside + '/' + datum.draws + ' in range'",
      "as": "row_label"
    },
    {
      "stack": "count",
      "groupby": [
        "marker"
      ],
      "as": [
        "s0",
        "s1"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "ord",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.s0",
      "as": "x0"
    },
    {
      "calculate": "datum.s1",
      "as": "x1"
    },
    {
      "calculate": "(datum.s0 + datum.s1) / 2",
      "as": "mid"
    },
    {
      "calculate": "datum.glyph + ' ' + datum.count",
      "as": "seg_label"
    },
    {
      "calculate": "datum.count + ' of ' + datum.draws + ' draws ' + datum.status",
      "as": "detail"
    }
  ],
  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "share_in",
        "op": "min"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 300
      }
    }
  },
  "layer": [
    {
      "name": "shares",
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.72
        },
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative",
          "title": "share of draws",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ]
          }
        },
        "x2": {
          "field": "x1"
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_range"
            }
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "detail",
            "title": "draws"
          },
          {
            "field": "status_label",
            "title": "status"
          }
        ]
      }
    },
    {
      "name": "counts",
      "transform": [
        {
          "filter": "datum.x1 - datum.x0 >= 0.09"
        }
      ],
      "mark": {
        "type": "text",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": "bold",
        "color": {
          "x-eas:slot": "surface"
        }
      },
      "encoding": {
        "x": {
          "field": "mid",
          "type": "quantitative"
        },
        "text": {
          "field": "seg_label"
        }
      }
    }
  ]
}
