{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "health-bullet",
    "version": "1.0.0",
    "doc": "Range bars: one row per marker on its own scale, the reference and optimal ranges as bands, the latest draw marked by status.",
    "slots": {
      "data": {
        "shape": "biomarker",
        "required": true,
        "doc": "health-chart measurements (the biomarker adapter)"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Range bars: one row per marker on its own scale, the reference and optimal ranges as bands, the latest draw marked by status.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "ref_color": {
        "type": "string",
        "default": "#b8b7ad",
        "doc": "reference band"
      },
      "opt_color": {
        "type": "string",
        "default": "#0ca30c",
        "doc": "optimal band"
      },
      "status_domain": {
        "type": "array",
        "items": "string",
        "default": [
          "\u25cf optimal",
          "\u25cb normal",
          "\u25d0 suboptimal",
          "\u25bc low",
          "\u25b2 high",
          "? n/a"
        ],
        "doc": "status legend entries, glyph and word (never color alone)"
      },
      "status_range": {
        "type": "array",
        "items": "string",
        "default": [
          "#0ca30c",
          "#2a78d6",
          "#e09a00",
          "#d03b3b",
          "#d03b3b",
          "#898781"
        ]
      },
      "status_shape": {
        "type": "array",
        "items": "string",
        "default": [
          "circle",
          "square",
          "diamond",
          "triangle-down",
          "triangle-up",
          "cross"
        ]
      },
      "x_format": {
        "type": "string",
        "default": "%Y",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "ref": {
        "type": "boolean",
        "default": true,
        "doc": "show the reference band"
      },
      "optimal": {
        "type": "boolean",
        "default": true,
        "doc": "show the optimal band"
      }
    },
    "example": "../examples/eas/health-bullet.data.json"
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 28
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "status"
    },
    {
      "x-eas:transform": "reference-band",
      "scale": "domain",
      "ref": {
        "x-eas:slot": "ref"
      },
      "optimal": {
        "x-eas:slot": "optimal"
      }
    },
    {
      "calculate": "0",
      "as": "track_lo"
    },
    {
      "calculate": "1",
      "as": "track_hi"
    },
    {
      "calculate": "datum.label + '  ' + datum.value_label + ' ' + datum.glyph",
      "as": "row_label"
    }
  ],
  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "sort": null,
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 300
      }
    }
  },
  "layer": [
    {
      "name": "track",
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        },
        "opacity": 0.55,
        "color": {
          "x-eas:slot": "grid"
        }
      },
      "encoding": {
        "x": {
          "field": "track_lo",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "x2": {
          "field": "track_hi"
        }
      }
    },
    {
      "name": "ref-band",
      "transform": [
        {
          "filter": "isValid(datum.ref_x) && isValid(datum.ref_x2)"
        }
      ],
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        },
        "opacity": 0.4,
        "color": {
          "x-eas:slot": "ref_color"
        }
      },
      "encoding": {
        "x": {
          "field": "ref_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "x2": {
          "field": "ref_x2"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "ref_range",
            "title": "reference"
          }
        ]
      }
    },
    {
      "name": "opt-band",
      "transform": [
        {
          "filter": "isValid(datum.opt_x) && isValid(datum.opt_x2)"
        }
      ],
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        },
        "opacity": 0.3,
        "color": {
          "x-eas:slot": "opt_color"
        }
      },
      "encoding": {
        "x": {
          "field": "opt_x",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              1
            ],
            "nice": false,
            "zero": false
          },
          "axis": null
        },
        "x2": {
          "field": "opt_x2"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "opt_range",
            "title": "optimal"
          }
        ]
      }
    },
    {
      "name": "marker",
      "transform": [
        {
          "filter": "isValid(datum.pos)"
        }
      ],
      "mark": {
        "type": "tick",
        "thickness": 2.5,
        "bandSize": 22,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "pos",
          "type": "quantitative"
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_range"
            }
          },
          "legend": {
            "title": null
          }
        }
      }
    },
    {
      "name": "latest",
      "transform": [
        {
          "filter": "isValid(datum.pos)"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 130,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "pos",
          "type": "quantitative"
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_range"
            }
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_shape"
            }
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "date",
            "type": "temporal",
            "format": "%Y-%m-%d"
          },
          {
            "field": "value_label",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          },
          {
            "field": "ref_range",
            "title": "reference"
          },
          {
            "field": "opt_range",
            "title": "optimal"
          }
        ]
      }
    }
  ]
}
