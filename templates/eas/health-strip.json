{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "health-strip",
    "version": "1.0.0",
    "doc": "Every draw of every marker on its own range scale (0 = reference low, 1 = reference high): grey ticks are earlier draws, the marker the latest.",
    "slots": {
      "data": {
        "shape": "biomarker",
        "required": true,
        "doc": "health-chart measurements (the biomarker adapter)"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Every draw of every marker on its own range scale (0 = reference low, 1 = reference high): grey ticks are earlier draws, the marker the latest.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "ref_color": {
        "type": "string",
        "default": "#b8b7ad",
        "doc": "reference band"
      },
      "opt_color": {
        "type": "string",
        "default": "#0ca30c",
        "doc": "optimal band"
      },
      "status_domain": {
        "type": "array",
        "items": "string",
        "default": [
          "\u25cf optimal",
          "\u25cb normal",
          "\u25d0 suboptimal",
          "\u25bc low",
          "\u25b2 high",
          "? n/a"
        ],
        "doc": "status legend entries, glyph and word (never color alone)"
      },
      "status_range": {
        "type": "array",
        "items": "string",
        "default": [
          "#0ca30c",
          "#2a78d6",
          "#e09a00",
          "#d03b3b",
          "#d03b3b",
          "#898781"
        ]
      },
      "status_shape": {
        "type": "array",
        "items": "string",
        "default": [
          "circle",
          "square",
          "diamond",
          "triangle-down",
          "triangle-up",
          "cross"
        ]
      },
      "x_format": {
        "type": "string",
        "default": "%Y",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "ref": {
        "type": "boolean",
        "default": true,
        "doc": "show the reference band"
      },
      "optimal": {
        "type": "boolean",
        "default": true,
        "doc": "show the optimal band"
      }
    },
    "example": "../examples/eas/health-strip.data.json"
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": 28
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "status"
    },
    {
      "x-eas:transform": "reference-band",
      "scale": "range",
      "ref": {
        "x-eas:slot": "ref"
      },
      "optimal": {
        "x-eas:slot": "optimal"
      }
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "rn"
        }
      ],
      "sort": [
        {
          "field": "date",
          "order": "descending"
        }
      ],
      "groupby": [
        "marker"
      ]
    },
    {
      "calculate": "datum.rn == 1 ? 1 : 0",
      "as": "latest"
    },
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "draws"
        }
      ],
      "groupby": [
        "marker"
      ]
    },
    {
      "calculate": "datum.label + '  ' + datum.value_label + ' ' + datum.glyph",
      "as": "draw_label"
    },
    {
      "window": [
        {
          "op": "last_value",
          "field": "draw_label",
          "as": "row_label"
        }
      ],
      "sort": [
        {
          "field": "date"
        }
      ],
      "groupby": [
        "marker"
      ],
      "frame": [
        null,
        null
      ]
    }
  ],
  "encoding": {
    "y": {
      "field": "row_label",
      "type": "nominal",
      "sort": null,
      "title": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 300
      }
    }
  },
  "layer": [
    {
      "name": "ref-band",
      "transform": [
        {
          "filter": "datum.latest == 1 && isValid(datum.ref_x)"
        }
      ],
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        },
        "opacity": 0.35,
        "color": {
          "x-eas:slot": "ref_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "field": "ref_x",
          "title": "position in reference range"
        },
        "x2": {
          "field": "ref_x2"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "ref_range",
            "title": "reference"
          }
        ]
      }
    },
    {
      "name": "opt-band",
      "transform": [
        {
          "filter": "datum.latest == 1 && isValid(datum.opt_x)"
        }
      ],
      "mark": {
        "type": "bar",
        "height": {
          "band": 0.62
        },
        "opacity": 0.25,
        "color": {
          "x-eas:slot": "opt_color"
        }
      },
      "encoding": {
        "x": {
          "type": "quantitative",
          "scale": {
            "nice": false,
            "zero": false
          },
          "field": "opt_x",
          "title": "position in reference range"
        },
        "x2": {
          "field": "opt_x2"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "opt_range",
            "title": "optimal"
          }
        ]
      }
    },
    {
      "name": "earlier",
      "transform": [
        {
          "filter": "datum.latest == 0"
        }
      ],
      "mark": {
        "type": "tick",
        "thickness": 2,
        "bandSize": 20,
        "color": {
          "x-eas:slot": "secondary"
        },
        "opacity": 0.55
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "date",
            "type": "temporal",
            "format": "%Y-%m-%d"
          },
          {
            "field": "value_label",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          }
        ]
      }
    },
    {
      "name": "latest",
      "transform": [
        {
          "filter": "datum.latest == 1"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "size": 150,
        "opacity": 1,
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_range"
            }
          },
          "legend": {
            "title": null
          }
        },
        "shape": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_shape"
            }
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "date",
            "type": "temporal",
            "format": "%Y-%m-%d",
            "title": "latest draw"
          },
          {
            "field": "value_label",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          },
          {
            "field": "ref_range",
            "title": "reference"
          },
          {
            "field": "opt_range",
            "title": "optimal"
          },
          {
            "field": "draws",
            "title": "draws"
          }
        ]
      }
    }
  ]
}
