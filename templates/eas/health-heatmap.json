{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "health-heatmap",
    "version": "1.0.0",
    "doc": "Markers by draw dates, each cell the draw's status: the out-of-range map.",
    "slots": {
      "data": {
        "shape": "biomarker",
        "required": true,
        "doc": "health-chart measurements (the biomarker adapter)"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Markers by draw dates, each cell the draw's status: the out-of-range map.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string",
        "default": "#0b0b0b"
      },
      "secondary": {
        "type": "string",
        "default": "#52514e"
      },
      "muted": {
        "type": "string",
        "default": "#898781"
      },
      "surface": {
        "type": "string",
        "default": "#fcfcfb"
      },
      "grid": {
        "type": "string",
        "default": "#e1e0d9"
      },
      "ref_color": {
        "type": "string",
        "default": "#b8b7ad",
        "doc": "reference band"
      },
      "opt_color": {
        "type": "string",
        "default": "#0ca30c",
        "doc": "optimal band"
      },
      "status_domain": {
        "type": "array",
        "items": "string",
        "default": [
          "\u25cf optimal",
          "\u25cb normal",
          "\u25d0 suboptimal",
          "\u25bc low",
          "\u25b2 high",
          "? n/a"
        ],
        "doc": "status legend entries, glyph and word (never color alone)"
      },
      "status_range": {
        "type": "array",
        "items": "string",
        "default": [
          "#0ca30c",
          "#2a78d6",
          "#e09a00",
          "#d03b3b",
          "#d03b3b",
          "#898781"
        ]
      },
      "status_shape": {
        "type": "array",
        "items": "string",
        "default": [
          "circle",
          "square",
          "diamond",
          "triangle-down",
          "triangle-up",
          "cross"
        ]
      },
      "x_format": {
        "type": "string",
        "default": "%Y",
        "doc": "time axis label format"
      },
      "x_ticks": {
        "type": "integer",
        "default": 5,
        "doc": "about this many time axis ticks"
      },
      "row_step": {
        "type": "integer",
        "default": 28,
        "doc": "pixels per marker row (a text row is 14)"
      }
    },
    "example": "../examples/eas/health-heatmap.data.json"
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": {
    "step": {
      "x-eas:slot": "row_step"
    }
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "status"
    },
    {
      "calculate": "datum.glyph + ' ' + datum.value_text",
      "as": "cell_label"
    }
  ],
  "encoding": {
    "x": {
      "field": "date",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelAngle": 0
      }
    },
    "y": {
      "field": "label",
      "type": "nominal",
      "sort": null,
      "title": null
    }
  },
  "layer": [
    {
      "name": "cells",
      "mark": {
        "type": "rect",
        "opacity": 0.9
      },
      "encoding": {
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": {
              "x-eas:slot": "status_domain"
            },
            "range": {
              "x-eas:slot": "status_range"
            }
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "label",
            "title": "marker"
          },
          {
            "field": "date",
            "title": "drawn"
          },
          {
            "field": "value_label",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          }
        ]
      }
    },
    {
      "name": "values",
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": "bold",
        "baseline": "middle",
        "align": "center",
        "color": {
          "x-eas:slot": "surface"
        }
      },
      "encoding": {
        "text": {
          "field": "cell_label"
        }
      }
    }
  ]
}
