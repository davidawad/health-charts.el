{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "agp",
    "version": "1.0.0",
    "doc": "Ambulatory glucose profile: many days of readings folded onto one 24 hour day as the median line with the 25-75th and 5-95th percentile bands (neutral blues) and, when the data source supplies it, the target range as a green band. The profile itself is not judged, so it uses no red or yellow.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, glucose}: ISO date-times with a clock time, from several days, oldest first"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "Ambulatory glucose profile: many days of readings folded onto one 24 hour day as the median line with the 25-75th and 5-95th percentile bands (neutral blues) and, when the data source supplies it, the target range as a green band. The profile itself is not judged, so it uses no red or yellow.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "low": {
        "type": "number",
        "default": null,
        "doc": "lower limit of the target range, from the data source or care team; the target band is drawn only when low or high is given (the open side runs to the data)"
      },
      "high": {
        "type": "number",
        "default": null,
        "doc": "upper limit of the target range, from the data source or care team"
      },
      "unit": {
        "type": "string",
        "default": "mg/dL",
        "doc": "glucose unit label, shown in titles (a label, not a threshold)"
      },
      "bucket_minutes": {
        "type": "integer",
        "default": 60,
        "doc": "width of a time-of-day bucket in minutes; must divide 1440"
      },
      "line_color": {
        "type": "string",
        "doc": "the median and the percentile bands (the theme's neutral line color, bands at lower opacity)"
      },
      "ok_color": {
        "type": "string",
        "doc": "the target range band (the theme's green)"
      }
    },
    "example": "examples/agp.data.json",
    "health": {
      "group": "glucose",
      "text_size": [
        100,
        26
      ],
      "svg_size": [
        1000,
        420
      ],
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "glucose": "range:10:800"
          },
          "order": "time"
        }
      },
      "rules": [
        {
          "le": [
            "low",
            "high"
          ],
          "code": "range_inverted"
        }
      ]
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": "container",
  "height": 260,
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "time-of-day-percentiles",
      "field": "glucose",
      "time": "time",
      "bucket_minutes": {
        "x-eas:slot": "bucket_minutes"
      }
    },
    {
      "x-eas:transform": "health-status",
      "value": "p50",
      "low": {
        "x-eas:slot": "low"
      },
      "high": {
        "x-eas:slot": "high"
      }
    }
  ],
  "layer": [
    {
      "name": "target",
      "transform": [
        {
          "aggregate": [
            {
              "op": "max",
              "field": "band_lo",
              "as": "y0"
            },
            {
              "op": "max",
              "field": "band_hi",
              "as": "y1"
            }
          ]
        },
        {
          "filter": "isValid(datum.y0)"
        }
      ],
      "mark": {
        "type": "rect",
        "opacity": 0.22,
        "color": {
          "x-eas:slot": "ok_color"
        }
      },
      "encoding": {
        "y": {
          "field": "y0",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "y2": {
          "field": "y1"
        },
        "tooltip": [
          {
            "value": "target range",
            "title": "range"
          }
        ]
      }
    },
    {
      "name": "p5-p95",
      "mark": {
        "type": "area",
        "opacity": 0.16,
        "color": {
          "x-eas:slot": "line_color"
        }
      },
      "encoding": {
        "x": {
          "field": "tod",
          "type": "quantitative",
          "title": "time of day (hours)",
          "scale": {
            "domain": [
              0,
              24
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "values": [
              0,
              3,
              6,
              9,
              12,
              15,
              18,
              21,
              24
            ],
            "grid": false
          }
        },
        "y": {
          "field": "p5",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          },
          "title": {
            "x-eas:text": "Glucose ({{unit}})"
          }
        },
        "y2": {
          "field": "p95"
        },
        "tooltip": [
          {
            "field": "tod",
            "title": "hour"
          },
          {
            "field": "p5",
            "title": "5th"
          },
          {
            "field": "p95",
            "title": "95th"
          }
        ]
      }
    },
    {
      "name": "p25-p75",
      "mark": {
        "type": "area",
        "opacity": 0.4,
        "color": {
          "x-eas:slot": "line_color"
        }
      },
      "encoding": {
        "x": {
          "field": "tod",
          "type": "quantitative",
          "title": "time of day (hours)",
          "scale": {
            "domain": [
              0,
              24
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "values": [
              0,
              3,
              6,
              9,
              12,
              15,
              18,
              21,
              24
            ],
            "grid": false
          }
        },
        "y": {
          "field": "p25",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "y2": {
          "field": "p75"
        },
        "tooltip": [
          {
            "field": "tod",
            "title": "hour"
          },
          {
            "field": "p25",
            "title": "25th"
          },
          {
            "field": "p75",
            "title": "75th"
          }
        ]
      }
    },
    {
      "name": "median",
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "color": {
          "x-eas:slot": "line_color"
        }
      },
      "encoding": {
        "x": {
          "field": "tod",
          "type": "quantitative",
          "title": "time of day (hours)",
          "scale": {
            "domain": [
              0,
              24
            ],
            "nice": false,
            "zero": false
          },
          "axis": {
            "values": [
              0,
              3,
              6,
              9,
              12,
              15,
              18,
              21,
              24
            ],
            "grid": false
          }
        },
        "y": {
          "field": "p50",
          "type": "quantitative",
          "scale": {
            "zero": false,
            "nice": true
          }
        },
        "tooltip": [
          {
            "field": "tod",
            "title": "hour"
          },
          {
            "field": "p50",
            "title": "median"
          },
          {
            "field": "n",
            "title": "readings"
          }
        ]
      }
    }
  ]
}
