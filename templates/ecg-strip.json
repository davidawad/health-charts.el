      },
      "duration": {
        "type": "number",
        "default": 2.4,
        "doc": "seconds shown on the time axis"
      },
      "mv_min": {
        "type": "number",
        "default": -0.5,
        "doc": "lowest millivolts shown"
      },
      "mv_max": {
        "type": "number",
        "default": 1.5,
        "doc": "highest millivolts shown"
