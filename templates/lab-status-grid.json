{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "x-eas": {
    "template": "lab-status-grid",
    "version": "1.0.0",
    "doc": "A grid of analytes by draw date: each cell is filled with its status color at partial opacity (red out of range, yellow near a limit or, with an optimal range, outside it (suboptimal), green in range, grey with no range) and carries a glyph (low, near, suboptimal, in range, high, ?) and the value, judged against that row's own reference range. Ranges come from the data, either limit may be missing.",
    "slots": {
      "data": {
        "shape": "plist",
        "required": true,
        "doc": "rows {time, analyte, value, ref_low?, ref_high?, opt_low?, opt_high?, warn_low?, warn_high?, warn_margin?}: every result, oldest first; rows of one analyte share a line; ref_low and ref_high come from the data source (either may be missing: one-sided; both missing: a grey ? cell); the warn fields override the yellow zone of that result; opt_low and opt_high (optional, inside the reference range) are the optimal range: inside the reference range but outside it is yellow \"suboptimal\", red is only outside the reference range"
      },
      "title": {
        "type": "string",
        "default": ""
      },
      "subtitle": {
        "type": "string",
        "default": ""
      },
      "description": {
        "type": "string",
        "default": "A grid of analytes by draw date: each cell is filled with its status color at partial opacity (red out of range, yellow near a limit or, with an optimal range, outside it (suboptimal), green in range, grey with no range) and carries a glyph (low, near, suboptimal, in range, high, ?) and the value, judged against that row's own reference range. Ranges come from the data, either limit may be missing.",
        "doc": "the takeaway; alt text and table-view fallback"
      },
      "config": {
        "type": "object",
        "default": {},
        "doc": "Vega-Lite config: background and axis colors from the theme"
      },
      "ink": {
        "type": "string"
      },
      "secondary": {
        "type": "string"
      },
      "muted": {
        "type": "string"
      },
      "surface": {
        "type": "string"
      },
      "grid": {
        "type": "string"
      },
      "bad_color": {
        "type": "string",
        "doc": "out of range (the theme's red)"
      },
      "warn_color": {
        "type": "string",
        "doc": "near a limit (the theme's yellow)"
      },
      "ok_color": {
        "type": "string",
        "doc": "in range (the theme's green)"
      },
      "unknown_color": {
        "type": "string",
        "doc": "no range to judge by (the theme's grey)"
      },
      "warn_margin": {
        "type": "number",
        "doc": "width of the yellow zone inside each limit, as a fraction of the range width (of the one bound for a one-sided range); a row's warn_margin overrides it"
      },
      "fill_opacity": {
        "type": "number",
        "default": 0.4,
        "doc": "opacity of the status fill, so the glyph and value stay readable"
      },
      "row_step": {
        "type": "integer",
        "default": 28,
        "doc": "cell height in pixels (a multiple of 14 reads well as text)"
      },
      "col_step": {
        "type": "integer",
        "default": 64,
        "doc": "cell width in pixels; a value wider than its cell is cut with an ellipsis, so it never runs into the label"
      },
      "decimals": {
        "type": "integer",
        "default": null,
        "doc": "exact decimals of every displayed number (a row's own decimals wins); without it a number shows sig_figs significant figures but never fewer decimals than its reference limits show. Display only: status is judged on the number as given"
      },
      "sig_figs": {
        "type": "integer",
        "doc": "significant figures of a displayed number when decimals is not set (the theme's :sig-figs, 3)"
      },
      "label_max": {
        "type": "integer",
        "doc": "the most characters of a row label before an ellipsis (the theme's :label-max, 28)"
      },
      "max_draws": {
        "type": "integer",
        "default": null,
        "doc": "show only the latest N draw dates (0 shows all). Without it a text view shows as many draws as its width holds, so no column is narrower than its cell text; the subtitle says when draws are left out"
      }
    },
    "example": "examples/lab-status-grid.data.json",
    "health": {
      "group": "labs",
      "tables": {
        "data": {
          "fields": {
            "time": "time",
            "analyte": "string",
            "value": "number",
            "ref_low": "?number",
            "ref_high": "?number",
            "opt_low": "?number",
            "opt_high": "?number",
            "warn_low": "?number",
            "warn_high": "?number",
            "warn_margin": "?range:0:1",
            "decimals": "?range:0:8"
          },
          "order": "time",
          "rows": [
            {
              "le": [
                "ref_low",
                "ref_high"
              ],
              "code": "range_inverted"
            },
            {
              "le": [
                "ref_low",
                "warn_low"
              ],
              "code": "warn_outside_range"
            },
            {
              "le": [
                "warn_high",
                "ref_high"
              ],
              "code": "warn_outside_range"
            },
            {
              "le": [
                "opt_low",
                "opt_high"
              ],
              "code": "range_inverted"
            },
            {
              "le": [
                "ref_low",
                "opt_low"
              ],
              "code": "opt_outside_range"
            },
            {
              "le": [
                "opt_high",
                "ref_high"
              ],
              "code": "opt_outside_range"
            }
          ]
        }
      },
      "text_size": [
        100,
        22
      ],
      "svg_size": [
        900,
        380
      ],
      "slots": {
        "warn_margin": "range:0:1",
        "fill_opacity": "range:0:1",
        "decimals": "range:0:8",
        "sig_figs": "range:1:10",
        "label_max": "range:4:200",
        "max_draws": "range:0:1000"
      },
      "fit": "draws"
    }
  },
  "title": {
    "text": {
      "x-eas:slot": "title"
    },
    "subtitle": {
      "x-eas:slot": "subtitle"
    }
  },
  "description": {
    "x-eas:slot": "description"
  },
  "config": {
    "x-eas:slot": "config"
  },
  "width": {
    "step": {
      "x-eas:slot": "col_step"
    }
  },
  "height": {
    "step": {
      "x-eas:slot": "row_step"
    }
  },
  "data": {
    "name": "data"
  },
  "transform": [
    {
      "x-eas:transform": "health-latest-draws",
      "time": "time",
      "max": {
        "x-eas:slot": "max_draws"
      }
    },
    {
      "x-eas:transform": "health-status",
      "value": "value",
      "low_field": "ref_low",
      "high_field": "ref_high",
      "margin": {
        "x-eas:slot": "warn_margin"
      },
      "opt_low_field": "opt_low",
      "opt_high_field": "opt_high"
    },
    {
      "x-eas:transform": "health-format",
      "fields": [
        "value"
      ],
      "decimals": {
        "x-eas:slot": "decimals"
      },
      "sig": {
        "x-eas:slot": "sig_figs"
      },
      "label_field": "analyte",
      "label_max": {
        "x-eas:slot": "label_max"
      }
    },
    {
      "calculate": "datum.status_glyph + ' ' + datum.value_text",
      "as": "cell"
    },
    {
      "calculate": "substring(datum.time, 0, 10)",
      "as": "day"
    }
  ],
  "encoding": {
    "x": {
      "field": "day",
      "type": "ordinal",
      "title": null,
      "sort": {
        "field": "day",
        "order": "ascending"
      },
      "axis": {
        "labelAngle": 0,
        "orient": "bottom",
        "labelLimit": 90
      }
    },
    "y": {
      "field": "analyte_short",
      "type": "nominal",
      "title": null,
      "sort": null,
      "axis": {
        "domain": false,
        "ticks": false,
        "labelLimit": 220,
        "labelPadding": 8
      }
    }
  },
  "layer": [
    {
      "name": "cells",
      "mark": {
        "type": "rect",
        "stroke": {
          "x-eas:slot": "surface"
        },
        "strokeWidth": 2,
        "opacity": {
          "x-eas:slot": "fill_opacity"
        }
      },
      "encoding": {
        "color": {
          "field": "status_label",
          "type": "nominal",
          "scale": {
            "domain": [
              "low",
              "near limit",
              "suboptimal",
              "in range",
              "high",
              "no range"
            ],
            "range": [
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "warn_color"
              },
              {
                "x-eas:slot": "ok_color"
              },
              {
                "x-eas:slot": "bad_color"
              },
              {
                "x-eas:slot": "unknown_color"
              }
            ]
          },
          "legend": {
            "title": null
          }
        },
        "tooltip": [
          {
            "field": "analyte"
          },
          {
            "field": "day",
            "title": "date"
          },
          {
            "field": "value_text",
            "title": "value"
          },
          {
            "field": "status_label",
            "title": "status"
          },
          {
            "field": "range_text",
            "title": "reference range"
          }
        ]
      }
    },
    {
      "name": "values",
      "mark": {
        "type": "text",
        "fontSize": 11,
        "color": {
          "x-eas:slot": "ink"
        },
        "limit": {
          "x-eas:slot": "col_step"
        }
      },
      "encoding": {
        "text": {
          "field": "cell"
        }
      }
    }
  ]
}
