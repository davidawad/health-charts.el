{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart delta: percent change per marker between two draws, diverging bars from 0 colored by verdict (glyph + word in the legend), each bar labeled with its change and its before and after values.",
  "width": 720,
  "height": 520,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": "#fcfcfb",
  "title": {
    "text": "Change 2025-03-10 → 2025-09-15 · alex", "subtitle": "percent change per marker; judged toward or away from target", "anchor": "start", "offset": 14,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": "#0b0b0b", "subtitleColor": "#52514e"
  },
  "config": {
    "font": "DejaVu Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#52514e", "titleColor": "#52514e", "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": "#e1e0d9",
      "domainColor": "#c3c2b7", "tickColor": "#c3c2b7"
    },
    "legend": {
      "labelColor": "#52514e", "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 140, "columnPadding": 18
    }
  },
  "data": {"values": [{"index":1,"marker":"ldl-c","label":"LDL-C","unit":"mg/dL","before":84,"after":76,"change":-8,"pct":-9.5,"pct_label":"-9.5%","value_label":"84 → 76 mg/dL","side":"neg","verdict":"improved","glyph":"✔","verdict_label":"✔ improved","color":"#0ca30c","rgb":828172,"text":"-9.5% ✔"},{"index":2,"marker":"hdl-c","label":"HDL-C","unit":"mg/dL","before":58,"after":61,"change":3,"pct":5.2,"pct_label":"+5.2%","value_label":"58 → 61 mg/dL","side":"pos","verdict":"improved","glyph":"✔","verdict_label":"✔ improved","color":"#0ca30c","rgb":828172,"text":"+5.2% ✔"},{"index":3,"marker":"triglycerides","label":"Triglycerides","unit":"mg/dL","before":96,"after":88,"change":-8,"pct":-8.3,"pct_label":"-8.3%","value_label":"96 → 88 mg/dL","side":"neg","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"-8.3% ●"},{"index":4,"marker":"apob","label":"ApoB","unit":"mg/dL","before":76,"after":72,"change":-4,"pct":-5.3,"pct_label":"-5.3%","value_label":"76 → 72 mg/dL","side":"neg","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"-5.3% ●"},{"index":5,"marker":"lpa","label":"Lp(a)","unit":"nmol/L","before":149,"after":144,"change":-5,"pct":-3.4,"pct_label":"-3.4%","value_label":"149 → 144 nmol/L","side":"neg","verdict":"improved","glyph":"✔","verdict_label":"✔ improved","color":"#0ca30c","rgb":828172,"text":"-3.4% ✔"},{"index":6,"marker":"hba1c","label":"HbA1c","unit":"%","before":5.3,"after":5.3,"change":0,"pct":0,"pct_label":"+0.0%","value_label":"5.3 → 5.3 %","side":"pos","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"+0.0% ●"},{"index":7,"marker":"glucose","label":"Glucose","unit":"mg/dL","before":96,"after":89,"change":-7,"pct":-7.3,"pct_label":"-7.3%","value_label":"96 → 89 mg/dL","side":"neg","verdict":"improved","glyph":"✔","verdict_label":"✔ improved","color":"#0ca30c","rgb":828172,"text":"-7.3% ✔"},{"index":8,"marker":"hscrp","label":"hs-CRP","unit":"mg/L","before":0.9,"after":0.8,"change":-0.1,"pct":-11.1,"pct_label":"-11.1%","value_label":"0.9 → 0.8 mg/L","side":"neg","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"-11.1% ●"},{"index":9,"marker":"vitamin-d","label":"Vitamin D","unit":"ng/mL","before":52,"after":55,"change":3,"pct":5.8,"pct_label":"+5.8%","value_label":"52 → 55 ng/mL","side":"pos","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"+5.8% ●"},{"index":10,"marker":"tsh","label":"TSH","unit":"mIU/L","before":2.3,"after":2.1,"change":-0.2,"pct":-8.7,"pct_label":"-8.7%","value_label":"2.3 → 2.1 mIU/L","side":"neg","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"-8.7% ●"},{"index":11,"marker":"ferritin","label":"Ferritin","unit":"ng/mL","before":160,"after":154,"change":-6,"pct":-3.8,"pct_label":"-3.8%","value_label":"160 → 154 ng/mL","side":"neg","verdict":"improved","glyph":"✔","verdict_label":"✔ improved","color":"#0ca30c","rgb":828172,"text":"-3.8% ✔"},{"index":12,"marker":"testosterone-total","label":"Testosterone","unit":"ng/dL","before":602,"after":618,"change":16,"pct":2.7,"pct_label":"+2.7%","value_label":"602 → 618 ng/dL","side":"pos","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"+2.7% ●"},{"index":13,"marker":"alt","label":"ALT","unit":"U/L","before":26,"after":24,"change":-2,"pct":-7.7,"pct_label":"-7.7%","value_label":"26 → 24 U/L","side":"neg","verdict":"on-target","glyph":"●","verdict_label":"● on-target","color":"#2a78d6","rgb":2783446,"text":"-7.7% ●"}]},
  "encoding": {
    "y": {
      "field": "label", "type": "nominal", "title": null,
      "scale": {"domain": ["LDL-C","HDL-C","Triglycerides","ApoB","Lp(a)","HbA1c","Glucose","hs-CRP","Vitamin D","TSH","Ferritin","Testosterone","ALT"], "paddingInner": 0.38, "paddingOuter": 0.2},
      "axis": {"labelFontSize": 12, "labelColor": "#0b0b0b", "labelPadding": 10,
               "ticks": false, "domain": false, "labelLimit": 220}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadius": 2},
      "encoding": {
        "x": {
          "field": "pct", "type": "quantitative", "title": "% change since the earlier draw",
          "scale": {"domain": [-16,16], "nice": false, "zero": true},
          "axis": {"tickCount": 6, "labelExpr": "datum.label + '%'", "grid": true, "labelPadding": 4,
                   "domain": false, "titlePadding": 8}
        },
        "x2": {"datum": 0},
        "color": {
          "field": "verdict_label", "type": "nominal",
          "scale": {"domain": ["✔ improved","● on-target"], "range": ["#0ca30c","#2a78d6"]},
          "legend": {"symbolType": "square"}
        },
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "pct_label", "title": "change"},
          {"field": "value_label", "title": "values"},
          {"field": "verdict_label", "title": "verdict"}
        ]
      }
    },
    {
      "data": {"values": [{"value":0,"label":"no change","axis":"x","color":"#c3c2b7"}]},
      "mark": {"type": "rule", "strokeWidth": 1.5, "color": "#52514e"},
      "encoding": {"x": {"field": "value", "type": "quantitative"}, "y": null}
    },
    {
      "transform": [{"filter": "datum.side === 'pos'"}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 7,
               "fontSize": 11.5, "color": "#0b0b0b"},
      "encoding": {"x": {"field": "pct", "type": "quantitative"}, "text": {"field": "text"}}
    },
    {
      "transform": [{"filter": "datum.side === 'neg'"}],
      "mark": {"type": "text", "align": "right", "baseline": "middle", "dx": -7,
               "fontSize": 11.5, "color": "#0b0b0b"},
      "encoding": {"x": {"field": "pct", "type": "quantitative"}, "text": {"field": "text"}}
    }
  ]
}
