{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "health-chart staleness: days since each indicator's draw as horizontal bars colored by state (glyph + word in the legend and at each bar end), with the due and stale thresholds as labeled vertical lines.",
  "width": 720,
  "height": 296,
  "autosize": {"type": "fit", "contains": "padding"},
  "padding": {"left": 12, "right": 20, "top": 12, "bottom": 8},
  "background": "#fcfcfb",
  "title": {
    "text": "Days since draw · sample", "subtitle": "as of 2025-10-01; due after 120 d, stale after 365 d", "anchor": "start", "offset": 30,
    "fontSize": 17, "subtitleFontSize": 12.5, "color": "#0b0b0b", "subtitleColor": "#52514e"
  },
  "config": {
    "font": "DejaVu Sans",
    "view": {"stroke": null},
    "axis": {
      "labelColor": "#52514e", "titleColor": "#52514e", "labelFontSize": 11.5,
      "titleFontSize": 11.5, "titleFontWeight": "normal", "gridColor": "#e1e0d9",
      "domainColor": "#c3c2b7", "tickColor": "#c3c2b7"
    },
    "legend": {
      "labelColor": "#52514e", "labelFontSize": 12, "orient": "bottom",
      "direction": "horizontal", "title": null, "symbolSize": 140, "columnPadding": 18
    }
  },
  "data": {"values": [{"index":1,"id":"health.cardio.apob","label":"ApoB","date":"2025-09-15","days":16,"bar":16,"days_label":"16 d","state":"fresh","glyph":"●","state_label":"● fresh","color":"#0ca30c","rgb":828172,"marker":"apob","person":"alex","text":"16 d · ● fresh"},{"index":2,"id":"health.cardio.lp-a","label":"Lp(a)","date":"2025-09-15","days":16,"bar":16,"days_label":"16 d","state":"fresh","glyph":"●","state_label":"● fresh","color":"#0ca30c","rgb":828172,"marker":"lpa","person":"alex","text":"16 d · ● fresh"},{"index":3,"id":"health.metabolic.hba1c","label":"HbA1c","date":"2025-09-15","days":16,"bar":16,"days_label":"16 d","state":"fresh","glyph":"●","state_label":"● fresh","color":"#0ca30c","rgb":828172,"marker":"hba1c","person":"alex","text":"16 d · ● fresh"},{"index":4,"id":"health.vitamin-d","label":"Vitamin D","date":"2025-09-15","days":16,"bar":16,"days_label":"16 d","state":"fresh","glyph":"●","state_label":"● fresh","color":"#0ca30c","rgb":828172,"marker":"vitamin_d","person":"alex","text":"16 d · ● fresh"}]},
  "encoding": {
    "y": {
      "field": "label", "type": "nominal", "title": null,
      "scale": {"domain": ["ApoB","Lp(a)","HbA1c","Vitamin D"], "paddingInner": 0.38, "paddingOuter": 0.2},
      "axis": {"labelFontSize": 12, "labelColor": "#0b0b0b", "labelPadding": 10,
               "ticks": false, "domain": false, "labelLimit": 220}
    }
  },
  "layer": [
    {
      "data": {"values": [{"value":120,"label":"due after 120 d","axis":"x","key":"due","color":"#e09a00"},{"value":365,"label":"stale after 365 d","axis":"x","key":"stale","color":"#d03b3b"}]},
      "layer": [
        {
          "mark": {"type": "rule", "strokeWidth": 1.5, "strokeDash": [5, 4]},
          "encoding": {
            "x": {"field": "value", "type": "quantitative"}, "y": null,
            "stroke": {"field": "color", "type": "nominal", "scale": null}
          }
        },
        {
          "mark": {"type": "text", "align": "center", "baseline": "bottom", "dy": -6,
                   "fontSize": 11.5, "fontWeight": "bold"},
          "encoding": {
            "x": {"field": "value", "type": "quantitative"}, "y": {"value": 0},
            "text": {"field": "label"},
            "fill": {"field": "color", "type": "nominal", "scale": null}
          }
        }
      ]
    },
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 2},
      "encoding": {
        "x": {
          "field": "bar", "type": "quantitative", "title": "days since draw",
          "scale": {"domain": [0,479], "nice": false, "zero": true},
          "axis": {"tickCount": 6, "grid": true, "labelPadding": 4, "titlePadding": 8}
        },
        "color": {
          "field": "state_label", "type": "nominal",
          "scale": {"domain": ["● fresh"], "range": ["#0ca30c"]},
          "legend": {"symbolType": "square"}
        },
        "tooltip": [
          {"field": "label", "title": "indicator"},
          {"field": "date", "title": "drawn"},
          {"field": "days_label", "title": "since"},
          {"field": "state_label", "title": "state"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 7,
               "fontSize": 11.5, "color": "#0b0b0b"},
      "encoding": {"x": {"field": "bar", "type": "quantitative"}, "text": {"field": "text"}}
    }
  ]
}
