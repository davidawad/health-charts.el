    {
      "transform": [{"filter": "datum.gap < 0"}],
      "mark": {"type": "text", "align": "center", "baseline": "top", "dy": 12, "fontSize": 12, "color": "#0b0b0b"},
      "encoding": {"y": {"field": "value", "type": "quantitative"}, "text": {"field": "gap_label"}}
