  "layer": [
    {
      "mark": {"type": "bar", "height": {"band": 0.72}, "stroke": "#fcfcfb", "strokeWidth": 1.5},
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "title": "share of draws",
              "scale": {"domain": [0, 1], "nice": false, "zero": false},
              "axis": {"values": [0, 0.25, 0.5, 0.75, 1], "labelExpr": "format(datum.value * 100, '.0f') + '%'",
                       "grid": true, "labelPadding": 4, "domain": false, "titlePadding": 8}},
        "x2": {"field": "x2"},
        "color": {"field": "status_label", "type": "nominal",
                  "scale": {"domain": ["● optimal","◐ suboptimal","▼ low","▲ high"], "range": ["#0ca30c","#e09a00","#d03b3b","#d03b3b"]},
                  "legend": {"symbolType": "square"}},
        "tooltip": [
          {"field": "label", "title": "marker"},
          {"field": "detail", "title": "draws"},
          {"field": "status_label", "title": "status"}
        ]
      }
    },
    {
      "transform": [{"filter": "datum.seg_label !== ''"}],
      "mark": {"type": "text", "baseline": "middle", "fontSize": 12, "fontWeight": "bold"},
      "encoding": {
        "x": {"field": "mid", "type": "quantitative"},
        "color": {"condition": {"test": "datum.status === 'suboptimal'", "value": "#0b0b0b"}, "value": "#ffffff"},
        "text": {"field": "seg_label"}
      }
    },
    {
      "transform": [{"aggregate": [{"op": "max", "field": "x2", "as": "end"}], "groupby": ["label", "summary"]}],
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 10, "fontSize": 12.5, "color": "#0b0b0b"},
      "encoding": {
        "x": {"datum": 1, "type": "quantitative"},
        "text": {"field": "summary"}
      }
    }
