#!/usr/bin/env bash
# health-chart from the shell: chart specs as JSON in, charts or JSON out.
#   health-chart render spec.json        (or: ... | health-chart render -)
#   health-chart explain|validate spec.json
#   biomarker trend --marker ldl_c --format json | health-chart pipe timeseries ['{"width":60}']
#   health-chart example KIND | kinds | describe | doctor | cohorts
#   health-chart cohort NAME ['{"kind":"staleness","person":"alex"}'] | cohort-explain NAME [PROPS]
# Set EMACS to pick the binary. See health-chart-batch.el for the spec format.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "${EMACS:-emacs}" -Q --batch -L "$here" -l health-chart-batch \
  -f health-chart-batch-main "$@"
