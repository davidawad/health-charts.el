#!/usr/bin/env bash
# health-chart from the shell: eas's verbs with the health templates loaded.
#   health-chart templates                      the catalog
#   health-chart validate vitals-trend --data b.json   error code and JSON path
#   health-chart example vitals-trend --raw > b.json   bindings that render as-is
#   health-chart render vitals-trend --data b.json --backend text --raw
#   health-chart render vitals-trend --data b.json --backend svg --raw > chart.svg
# check, export, explain, describe and doctor are eas's.  EAS points at an
# eas.el checkout (default: eas.el beside this repository).  Set EMACS to
# pick the binary.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
eas="${EAS:-$here/../eas.el}"
exec "${EMACS:-emacs}" -Q --batch --eval '(setq load-prefer-newer t)' \
  -L "$eas/src" -L "$here/src" -l health-chart-cli \
  -f health-chart-cli-main -- "$@"
